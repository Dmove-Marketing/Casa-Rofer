---
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import LeadForm from '../components/forms/LeadForm.astro';
import { tipoEventoOptions } from '../scripts/lead-payload';
import Img from '../components/ui/Img.astro';

const bioFields = [
  { type: 'row', fields: [
    { name: 'nome',     type: 'text',   label: 'Nome',     required: true },
    { name: 'telefone', type: 'text',   label: 'Telefone', required: true },
  ]},
  { type: 'row', fields: [
    { name: 'email', type: 'email', label: 'E-mail', required: true },
    { name: 'tipo_evento', type: 'select', label: 'Tipo de evento', required: true, options: [
      { value: '', disabled: true, selected: true, label: 'Selecione o tipo de evento' },
      ...tipoEventoOptions,
    ]},
  ]},
  { type: 'row', fields: [
    { name: 'data_evento', type: 'text',   label: 'Data do evento', placeholder: 'dd/mm/aaaa', datepicker: true, required: true },
    { name: 'convidados',  type: 'number', label: 'Número de convidados', required: true },
  ]},
  { name: 'detalhes_adicionais', type: 'textarea', label: 'Detalhes adicionais', hint: 'não obrigatório', rows: 3 }
];
---

<Base
  title="Casa Rofer — Orçamento | Brooklin, São Paulo"
  description="Fale conosco e solicite um orçamento personalizado para sua celebração ou evento corporativo."
  ogImage="/images/og-index.jpg"
>
  <main class="bio-container">
    <div class="bio-content">
      <div class="bio-header">
        <Img class="bio-logo" src="https://media.dmove.com.br/clients/casa-rofer/photos/logo-white.webp" alt="Casa Rofer" width={180} sizes="180px" priority />
        <h1 class="bio-title">A arte de transformar<br><span class="accent">o instante em memórias</span></h1>
      </div>

      <div class="bio-card">
        <LeadForm
          formId="bio-form"
          project={config.project_slug}
          submitUrl={config.forms['lead-form'].webhooks[0]}
          redirectUrl={config.forms['lead-form'].redirect_on_success}
          submitText="Solicitar Orçamento"
          honeypot
          fields={bioFields}
          successTitle="Recebemos sua solicitação ✦"
          successText="Obrigado pelo contato. Em breve nossa equipe retornará para começar a planejar o seu evento."
        />
      </div>
      <footer class="bio-footer">
        <span>© 2026 Casa Rofer · Brooklin, São Paulo. Todos os direitos reservados.</span>
        <span style="display:inline-flex;align-items:center;justify-content:center;gap:8px">Desenvolvido por <a href="https://www.dmove.com.br" target="_blank" rel="noopener" style="display:inline-flex;align-items:center"><img src="https://media.dmove.com.br/clients/casa-rofer/photos/Logotipo-dmove.webp" alt="Dmove" width="72" height="30" loading="lazy" style="height:30px;width:auto;opacity:0.95" /></a></span>
      </footer>
    </div>
  </main>
</Base>

<style>
  /* ===== FONTS IMPORT (Para itálicos PP Editorial New) ===== */
  @font-face {
    font-family: 'PP Editorial New';
    src: url('/src/assets/fonts/PPEditorialNew-Italic.woff2') format('woff2');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  .accent {
    font-family: 'PP Editorial New', serif;
    font-style: italic;
    font-weight: 400;
  }

  /* ===== LAYOUT & BG ===== */
  .bio-container {
    min-height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 5vw, 60px) 16px;
    background: linear-gradient(rgba(26, 23, 20, 0.6), rgba(26, 23, 20, 0.85)),
                url('https://media.dmove.com.br/api/public/resize/900/clients/casa-rofer/photos/bio-casa-rofer.webp') no-repeat center center;
    background-size: cover;
    background-attachment: fixed;
    position: relative;
    overflow-y: auto;
  }

  @media (min-width: 900px) {
    .bio-container {
      background-image: linear-gradient(rgba(26, 23, 20, 0.6), rgba(26, 23, 20, 0.85)),
                         url('https://media.dmove.com.br/api/public/resize/1600/clients/casa-rofer/photos/bio-casa-rofer.webp');
    }
  }

  /* ===== WRAPPER/CONTENT ===== */
  .bio-content {
    width: 100%;
    max-width: 620px;
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 4vw, 36px);
  }

  /* ===== CARD ===== */
  .bio-card {
    width: 100%;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 16px;
    padding: clamp(24px, 6vw, 48px);
    padding-top: clamp(16px, 4vw, 24px);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);

    /* Sobrescrita de variáveis CSS do Astro para o LeadForm */
    --ink: #ffffff;
    --ink-soft: rgba(255, 255, 255, 0.7);
    --line: rgba(255, 255, 255, 0.25);
    --title: #ffffff;
    --bg-card: transparent;
    --sand: #ada28f;
    --sand-deep: #ffffff;
  }

  /* ===== HEADER ===== */
  .bio-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-bottom: clamp(20px, 4vw, 36px);
  }

  .bio-logo {
    width: 180px;
    height: auto;
    display: block;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: clamp(16px, 3vw, 24px);
  }

  .bio-title {
    font-family: 'Aktiv Grotesk', sans-serif;
    font-weight: 400;
    font-size: clamp(1.9rem, 4vw, 3.1rem);
    line-height: 0.85;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  /* ===== FOOTER ===== */
  .bio-footer {
    text-align: center;
    font-family: 'Aktiv Grotesk', sans-serif;
    font-size: 0.78rem;
    opacity: 0.6;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
  }
  .bio-footer a {
    color: var(--sand);
    text-decoration: none;
    font-weight: 500;
  }
  .bio-footer a:hover {
    text-decoration: underline;
  }

  /* ===== CUSTOM ADJUSTMENTS FOR WHITE FORM ===== */
  .bio-card :global(.form-submit) {
    background: var(--sand);
    color: #ffffff;
    font-weight: 600;
    border: 1px solid var(--sand);
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }

  .bio-card :global(.form-submit:hover) {
    background: transparent;
    color: #ffffff;
    border-color: #ffffff;
    box-shadow: none;
  }

  .bio-card :global(.form-select) {
    color: #ffffff;
  }

  .bio-card :global(.form-select option) {
    background: #1a1714;
    color: #ffffff;
  }

  .bio-card :global(.form-success-icon) {
    background: var(--sand) !important;
    color: #1a1714 !important;
  }

  .bio-card :global(.form-success-icon svg) {
    stroke: #1a1714 !important;
  }

  /* ===== FLATPICKR — tema Casa Rofer (neutro + areia) ===== */
  :global(.bio-container) :global(.flatpickr-calendar) {
    background: linear-gradient(180deg, rgba(38, 35, 31, 0.98), rgba(26, 23, 20, 0.98));
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    padding: 18px;
    width: auto !important;
    margin-top: 12px !important;
    animation: fp-fade-in .22s ease-out;
  }

  @keyframes fp-fade-in {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  :global(.bio-container) :global(.flatpickr-calendar.arrowTop:before),
  :global(.bio-container) :global(.flatpickr-calendar.arrowTop:after),
  :global(.bio-container) :global(.flatpickr-calendar.arrowBottom:before),
  :global(.bio-container) :global(.flatpickr-calendar.arrowBottom:after) {
    display: none;
  }

  :global(.bio-container) :global(.flatpickr-months) {
    display: flex;
    align-items: center;
    padding-bottom: 14px;
    margin-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  :global(.bio-container) :global(.flatpickr-month) {
    color: #ffffff;
    fill: #ffffff;
    height: auto;
  }

  :global(.bio-container) :global(.flatpickr-current-month) {
    font-family: 'PP Editorial New', serif;
    font-style: italic;
    font-weight: 400;
    font-size: 1.15rem;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0;
  }

  :global(.bio-container) :global(.flatpickr-current-month .cur-month) {
    font-family: 'PP Editorial New', serif;
    font-style: italic;
  }

  :global(.bio-container) :global(.flatpickr-current-month input.cur-year) {
    color: rgba(255, 255, 255, 0.75);
    font-family: 'Aktiv Grotesk', sans-serif;
    font-style: normal;
    font-size: 0.95rem;
    font-weight: 400;
  }

  :global(.bio-container) :global(.flatpickr-current-month .flatpickr-monthDropdown-months) {
    background: transparent;
    color: #ffffff;
    font-family: 'PP Editorial New', serif;
    font-style: italic;
    appearance: none;
    border: none;
  }

  :global(.bio-container) :global(.flatpickr-current-month .flatpickr-monthDropdown-months option) {
    background: #1a1714;
    color: #ffffff;
    font-style: normal;
  }

  :global(.bio-container) :global(.numInputWrapper span.arrowUp),
  :global(.bio-container) :global(.numInputWrapper span.arrowDown) {
    display: none;
  }

  :global(.bio-container) :global(.flatpickr-prev-month),
  :global(.bio-container) :global(.flatpickr-next-month) {
    fill: rgba(255, 255, 255, 0.55);
    color: rgba(255, 255, 255, 0.55);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color .25s, fill .25s, color .25s;
  }

  :global(.bio-container) :global(.flatpickr-prev-month svg),
  :global(.bio-container) :global(.flatpickr-next-month svg) {
    width: 14px;
    height: 14px;
  }

  :global(.bio-container) :global(.flatpickr-prev-month:hover),
  :global(.bio-container) :global(.flatpickr-next-month:hover) {
    background: rgba(255, 255, 255, 0.08);
    fill: var(--sand);
    color: var(--sand);
  }

  :global(.bio-container) :global(.flatpickr-weekdays) {
    background: transparent;
    margin-bottom: 6px;
  }

  :global(.bio-container) :global(span.flatpickr-weekday) {
    background: transparent;
    color: rgba(255, 255, 255, 0.4);
    font-family: 'Aktiv Grotesk', sans-serif;
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 500;
  }

  :global(.bio-container) :global(.flatpickr-day) {
    color: rgba(255, 255, 255, 0.82);
    border-radius: 50%;
    font-family: 'Aktiv Grotesk', sans-serif;
    font-size: 0.86rem;
    height: 36px;
    line-height: 36px;
    max-width: 36px;
    margin: 1px 0;
  }

  :global(.bio-container) :global(.flatpickr-day.today) {
    border-color: var(--sand);
    color: #ffffff;
  }

  :global(.bio-container) :global(.flatpickr-day.today:hover) {
    border-color: var(--sand);
  }

  :global(.bio-container) :global(.flatpickr-day:hover) {
    background: rgba(255, 255, 255, 0.1);
    border-color: transparent;
    color: #ffffff;
  }

  :global(.bio-container) :global(.flatpickr-day.selected),
  :global(.bio-container) :global(.flatpickr-day.selected:hover) {
    background: var(--sand);
    border-color: var(--sand);
    color: #1a1714;
    font-weight: 600;
    box-shadow: 0 6px 18px rgba(173, 162, 143, 0.4);
  }

  :global(.bio-container) :global(.flatpickr-day.flatpickr-disabled),
  :global(.bio-container) :global(.flatpickr-day.flatpickr-disabled:hover) {
    color: rgba(255, 255, 255, 0.6);
    cursor: not-allowed;
  }

  :global(.bio-container) :global(.flatpickr-day.prevMonthDay),
  :global(.bio-container) :global(.flatpickr-day.nextMonthDay) {
    color: rgba(255, 255, 255, 0.25);
  }
</style>
