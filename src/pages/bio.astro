---
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import LeadForm from '../components/forms/LeadForm.astro';

const bioFields = [
  { type: 'row', fields: [
    { name: 'nome',     type: 'text',   label: 'Nome',     required: true },
    { name: 'telefone', type: 'text',   label: 'Telefone', required: true },
  ]},
  { name: 'email', type: 'email', label: 'E-mail', required: true },
  { type: 'row', fields: [
    { name: 'data',       type: 'text',   label: 'Data do evento', placeholder: 'dd/mm/aaaa' },
    { name: 'convidados', type: 'number', label: 'Número de convidados' },
  ]},
  { name: 'tipo_evento', type: 'select', label: 'Tipo de evento', options: [
    { value: '', disabled: true, selected: true, label: 'Selecione o tipo de evento' },
    { value: 'Aniversario', label: 'Aniversário' },
    { value: 'Aniversario debutante', label: 'Aniversário debutante' },
    { value: 'Bodas', label: 'Bodas' },
    { value: 'Casamento', label: 'Casamento' },
    { value: 'Confraternizacao corporativa', label: 'Confraternização corporativa' },
    { value: 'Confraternizacao social', label: 'Confraternização social' },
    { value: 'Corporativo', label: 'Corporativo' },
    { value: 'Feiras e Exposicoes', label: 'Feiras e Exposições' },
    { value: 'Masterclass e Palestras', label: 'Masterclass e Palestras' },
    { value: 'Mentorias e Treinamentos', label: 'Mentorias e Treinamentos' },
    { value: 'Offsite corporativo', label: 'Offsite corporativo' },
    { value: 'Reunioes de Networking', label: 'Reuniões de Networking' },
    { value: 'Workshops, Conferencias e Seminarios', label: 'Workshops, Conferências e Seminários' },
    { value: 'Outros', label: 'Outros' }
  ]},
  { name: 'detalhes', type: 'textarea', label: 'Detalhes adicionais', rows: 3 }
];
---

<Base
  title="Casa Rofer — Orçamento | Brooklin, São Paulo"
  description="Fale conosco e solicite um orçamento personalizado para sua celebração ou evento corporativo."
  ogImage="https://media.dmove.com.br/clients/casa-rofer/photos/bio-casa-rofer.webp"
>
  <main class="bio-container">
    <div class="bio-content">
      <div class="bio-header">
        <img class="bio-logo" src="https://media.dmove.com.br/clients/casa-rofer/photos/logo-white.webp" alt="Casa Rofer" />
        <h1 class="bio-title">A arte de transformar<br><span class="accent">o instante em memórias</span></h1>
      </div>

      <div class="bio-card">
        <LeadForm
          formId="bio-form"
          project={config.project_slug}
          submitUrl={config.forms['lead-form'].webhooks[0]}
          redirectUrl={config.forms['lead-form'].redirect_on_success}
          submitText="Solicitar Orçamento"
          honeypot
          fields={bioFields}
          successTitle="Recebemos sua solicitação ✦"
          successText="Obrigado pelo contato. Em breve nossa equipe retornará para começar a planejar o seu evento."
        />
      </div>
      <footer class="bio-footer">
        <span>© 2026 Casa Rofer · Brooklin, São Paulo. Todos os direitos reservados.</span>
        <span style="display:inline-flex;align-items:center;justify-content:center;gap:8px">Desenvolvido por <a href="https://www.dmove.com.br" target="_blank" rel="noopener" style="display:inline-flex;align-items:center"><img src="https://media.dmove.com.br/clients/casa-rofer/photos/Logotipo-dmove.webp" alt="Dmove" style="height:30px;width:auto;opacity:0.95" /></a></span>
      </footer>
    </div>
  </main>
</Base>

<style>
  /* ===== FONTS IMPORT (Para itálicos PP Editorial New) ===== */
  @font-face {
    font-family: 'PP Editorial New';
    src: url('/src/assets/fonts/PPEditorialNew-Italic.woff2') format('woff2');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  .accent {
    font-family: 'PP Editorial New', serif;
    font-style: italic;
    font-weight: 400;
  }

  /* ===== LAYOUT & BG ===== */
  .bio-container {
    min-height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 5vw, 60px) 16px;
    background: linear-gradient(rgba(2, 61, 45, 0.48), rgba(2, 61, 45, 0.8)), 
                url('https://media.dmove.com.br/clients/casa-rofer/photos/bio-casa-rofer.webp') no-repeat center center;
    background-size: cover;
    background-attachment: fixed;
    position: relative;
    overflow-y: auto;
  }

  /* ===== WRAPPER/CONTENT ===== */
  .bio-content {
    width: 100%;
    max-width: 620px;
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 4vw, 36px);
  }

  /* ===== CARD ===== */
  .bio-card {
    width: 100%;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 16px;
    padding: clamp(24px, 6vw, 48px);
    padding-top: clamp(16px, 4vw, 24px);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);

    /* Sobrescrita de variáveis CSS do Astro para o LeadForm */
    --ink: #ffffff;
    --ink-soft: rgba(255, 255, 255, 0.7);
    --line: rgba(255, 255, 255, 0.25);
    --title: #ffffff;
    --bg-card: transparent;
    --sand: #ada28f;
    --sand-deep: #ffffff;
  }

  /* ===== HEADER ===== */
  .bio-header {
    text-align: center;
    margin-bottom: clamp(20px, 4vw, 36px);
  }

  .bio-logo {
    width: 180px;
    height: auto;
    margin: 0 auto clamp(16px, 3vw, 24px);
    display: block;
  }

  .bio-title {
    font-family: 'Aktiv Grotesk', sans-serif;
    font-weight: 400;
    font-size: clamp(1.9rem, 4vw, 3.1rem);
    line-height: 1.15;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  /* ===== FOOTER ===== */
  .bio-footer {
    text-align: center;
    font-family: 'Aktiv Grotesk', sans-serif;
    font-size: 0.78rem;
    opacity: 0.6;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
  }
  .bio-footer a {
    color: var(--sand);
    text-decoration: none;
    font-weight: 500;
  }
  .bio-footer a:hover {
    text-decoration: underline;
  }

  /* ===== CUSTOM ADJUSTMENTS FOR WHITE FORM ===== */
  .bio-card :global(.form-submit) {
    background: var(--sand);
    color: #ffffff;
    font-weight: 600;
    border: 1px solid var(--sand);
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }

  .bio-card :global(.form-submit:hover) {
    background: transparent;
    color: #ffffff;
    border-color: #ffffff;
    box-shadow: none;
  }

  .bio-card :global(.form-select) {
    color: #ffffff;
  }

  .bio-card :global(.form-select option) {
    background: #023d2d;
    color: #ffffff;
  }

  .bio-card :global(.form-success-icon) {
    background: var(--sand) !important;
    color: #023d2d !important;
  }

  .bio-card :global(.form-success-icon svg) {
    stroke: #023d2d !important;
  }
</style>
