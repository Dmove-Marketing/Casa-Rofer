---
// Gerado a partir de: black-november.html
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import '../styles/black-november.css';
---

<Base
  title="Black November Casa Rofer | Até 25% OFF para casamentos em 2027"
  description="Black November Casa Rofer: de 01 a 30 de novembro, até 25% OFF ou cortesias em gastronomia, bar, audiovisual e decoração para casamentos em 2027 no Brooklin, São Paulo."
  ogImage="https://media.dmove.com.br/clients/casa-rofer/photos/hero-cerimonia-jardim-de-inverno.webp"
  canonical="https://eventos.casarofer.com.br/casamentos-black-november/"
>
<main>  
  
 <!-- HERO -->  
 <section class="hero" id="topo">  
 <div class="hero__imagem">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/hero-cerimonia-jardim-de-inverno.webp" alt="Cerimônia de casamento no jardim de inverno da Casa Rofer, com corredor de flores brancas e cadeiras dos convidados" width={1535} height={1025} priority />  
 </div>  
 <div class="hero__conteudo">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/logo-casa-rofer-areia.png" alt="Casa Rofer" width={640} height={228} class="hero__logo" />  
 <h1 class="hero__titulo">  
 <span class="hero__titulo-linha">Black</span>  
 <span class="hero__titulo-linha hero__titulo-linha--menor">November</span>  
 <span class="visualmente-oculto">Casa Rofer</span>  
 </h1>  
 <p class="hero__periodo">De 01 a 30 de novembro</p>  
 <p class="hero__oferta" aria-label="Até 25% OFF">  
 <span class="hero__ate" aria-hidden="true">Até</span>  
 <span class="hero__percentual" aria-hidden="true"><span class="hero__percentual-interno">25%</span></span>  
 <span class="hero__off" aria-hidden="true">OFF</span>  
 </p>  
 <p class="hero__publico">para <strong>casamentos em 2027</strong>.</p>  
 <a class="botao botao--claro hero__cta" href="#contato">Solicitar contato</a>  
 </div>  
 </section>  
  
 <!-- GALERIA �?" mosaico; clique amplia a foto -->  
 <section class="galeria" id="galeria" aria-labelledby="galeria-titulo">  
 <div class="container">  
 <div class="galeria__cabecalho">  
 <span class="rotulo">Galeria</span>  
 <h2 class="galeria__titulo" id="galeria-titulo">Celebrações que já ganharam<br class="br-desktop"> vida na Casa Rofer</h2>  
 </div>  
 <ul class="mosaico" aria-label="Fotos de casamentos na Casa Rofer">  
 <li class="mosaico__foto mosaico__foto--vertical mosaico__foto--grande">  
 <button class="mosaico__botao" type="button" data-legenda="Saída da cerimônia" aria-label="Ampliar foto: Saída da cerimônia">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-01-saida-da-cerimonia.webp" alt="Noivos comemorando a saída da cerimônia sob arco de flores, aplaudidos pelos convidados" width={933} height={1400} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--alta mosaico__foto--vertical">  
 <button class="mosaico__botao" type="button" data-legenda="Fachada da Casa Rofer" aria-label="Ampliar foto: Fachada da Casa Rofer">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-05-fachada-casa-rofer.webp" alt="Fachada da Casa Rofer com jardineira de flores, letreiro e entrada principal iluminada" width={933} height={1400} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--alta mosaico__foto--vertical">  
 <button class="mosaico__botao" type="button" data-legenda="Salão com telão e mesas postas" aria-label="Ampliar foto: Salão com telão e mesas postas">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-06-salao-com-telao-e-mesa-posta.webp" alt="Salão com telão exibindo foto dos noivos e mesa redonda posta com arranjo de flores" width={933} height={1400} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--larga">  
 <button class="mosaico__botao" type="button" data-legenda="Cerimônia no jardim de inverno" aria-label="Ampliar foto: Cerimônia no jardim de inverno">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-03-cerimonia-montada-jardim-de-inverno.webp" alt="Cerimônia montada no jardim de inverno, com cadeiras de palhinha, arranjos de flores brancas e arco floral" width={1400} height={933} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--vertical mosaico__foto--alta">  
 <button class="mosaico__botao" type="button" data-legenda="Primeira dança na pista de LED" aria-label="Ampliar foto: Primeira dança na pista de LED">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-02-primeira-danca-pista-led.webp" alt="Primeira dança dos noivos na pista de LED cercada pelos convidados" width={1128} height={1394} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--vertical mosaico__foto--alta">  
 <button class="mosaico__botao" type="button" data-legenda="A dança dos noivos" aria-label="Ampliar foto: A dança dos noivos">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-04-danca-dos-noivos.webp" alt="Noivo inclinando a noiva durante a dança no salão" width={1120} height={1400} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--larga">  
 <button class="mosaico__botao" type="button" data-legenda="Salão com escada" aria-label="Ampliar foto: Salão com escada">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-10-salao-com-escada.webp" alt="Salão com piso de madeira, escada, paredes de tijolo e mesas redondas montadas" width={1400} height={933} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--larga">  
 <button class="mosaico__botao" type="button" data-legenda="Jardim de inverno" aria-label="Ampliar foto: Jardim de inverno">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-08-salao-jardim-de-inverno.webp" alt="Salão jardim de inverno da Casa Rofer montado para casamento" width={1400} height={933} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--larga">  
 <button class="mosaico__botao" type="button" data-legenda="Lounge do salão" aria-label="Ampliar foto: Lounge do salão">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-11-lounge-do-salao.webp" alt="Lounge do salão com sofás, piso de madeira e iluminação quente nas cortinas" width={1400} height={933} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--vertical mosaico__foto--grande">  
 <button class="mosaico__botao" type="button" data-legenda="O brinde" aria-label="Ampliar foto: O brinde">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-07-brinde-com-convidados.webp" alt="Noivos brindando com os convidados à mesa" width={1052} height={1400} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--larga">  
 <button class="mosaico__botao" type="button" data-legenda="Mesa de doces com flores" aria-label="Ampliar foto: Mesa de doces com flores">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-12-mesa-de-doces-com-flores.webp" alt="Mesa de doces decorada com arranjos de flores laranja e vermelhas diante da parede de pedra" width={1400} height={1000} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--larga">  
 <button class="mosaico__botao" type="button" data-legenda="Salão parede verde" aria-label="Ampliar foto: Salão parede verde">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-09-salao-parede-verde.webp" alt="Salão com parede verde, teto de vidro e mesas montadas para o casamento" width={1400} height={933} />  
 </button>  
 </li>  
 </ul>  
 </div>  
 </section>  
  
 <div class="ampliada" role="dialog" aria-modal="true" aria-label="Foto ampliada" aria-hidden="true">  
 <button class="galeria__botao ampliada__fechar" type="button" aria-label="Fechar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>  
 <div class="ampliada__palco"><Img src="placeholder.jpg" alt="" /></div>  
 </div>  
  
 <!-- SOBRE / CONDI�?�.ES -->  
 <section class="sobre" id="condicoes">  
 <div class="container">  
 <span class="rotulo">Black November 2026</span>  
 <h2 class="sobre__titulo">Escolha a condição<br class="br-desktop"><br class="br-mobile"> ideal para a sua data</h2>  
 <p class="sobre__texto sobre__texto--abertura oculto-mobile">Três possibilidades para celebrar em 2027 com benefícios exclusivos da Black November.</p>  
 <p class="sobre__texto oculto-mobile">De acordo com a data escolhida, você pode aproveitar descontos de até 25% OFF ou combinar a contratação com cortesias em gastronomia, bar, audiovisual e decoração.</p>  
 <p class="sobre__texto so-mobile">Três condições exclusivas para 2027. Conforme a data, até 25% OFF ou desconto com cortesias em gastronomia, bar, audiovisual e decoração.</p>  
  
 <ul class="condicoes-lista">  
 <li class="condicoes-lista__item">  
 <a href="#beneficio-25-off">  
 <span class="condicoes-lista__numero">Condição 01</span>  
 <span class="condicoes-lista__nome">25% OFF para<br class="br-desktop"> datas próximas</span>  
 <span class="condicoes-lista__seta">Ver condição �?'</span>  
 </a>  
 </li>  
 <li class="condicoes-lista__item">  
 <a href="#beneficio-20-off">  
 <span class="condicoes-lista__numero">Condição 02</span>  
 <span class="condicoes-lista__nome">20% OFF<br class="br-desktop"> + 4 cortesias</span>  
 <span class="condicoes-lista__seta">Ver condição �?'</span>  
 </a>  
 </li>  
 <li class="condicoes-lista__item">  
 <a href="#beneficio-16-off">  
 <span class="condicoes-lista__numero">Condição 03</span>  
 <span class="condicoes-lista__nome">16% OFF<br class="br-desktop"> + 4 experiências</span>  
 <span class="condicoes-lista__seta">Ver condição �?'</span>  
 </a>  
 </li>  
 </ul>  
 </div>  
 </section>  
  
 <!-- BENEFÍCIO 1 -->  
 <section class="beneficio beneficio--areia" id="beneficio-25-off">  
 <div class="container beneficio__grade">  
 <div class="beneficio__imagem">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/beneficio-25-off-cerimonia.webp" alt="Noivos no altar durante a cerimônia no jardim de inverno, cercados por arranjos de flores brancas e convidados" width={1400} height={933} />  
 </div>  
 <div class="beneficio__conteudo">  
 <span class="rotulo">Condição 01</span>  
 <h2 class="beneficio__titulo">25% OFF para datas próximas</h2>  
 <p class="beneficio__texto">Condição especial para quem já está<br class="br-desktop"> planejando os próximos meses de 2027.<span class="oculto-desktop oculto-mobile">*</span></p>  
  
 <div class="inclui">  
 <p class="inclui__titulo">A condição inclui:</p>  
 <p class="inclui__principal"><span class="visualmente-oculto">25% OFF</span><span aria-hidden="true"><span class="contador" data-valor="25">25</span>% <span class="destaque-off">OFF</span></span></p>  
 <ul class="inclui__lista">  
 <li><span><span class="inclui__mais">+</span> entrada de 20%</span></li>  
 </ul>  
 </div>  
  
 <p class="beneficio__nota">*Válido para janeiro, fevereiro, março e abril de 2027, em datas que caem durante a semana, domingos e feriados, exceto sábados.</p>  
 <a class="botao botao--primario beneficio__cta" href="#contato">Consulte datas disponíveis</a>  
 </div>  
 </div>  
 </section>  
  
 <!-- BENEFÍCIO 2 -->  
 <section class="beneficio beneficio--invertido" id="beneficio-20-off">  
 <div class="container beneficio__grade">  
 <div class="beneficio__imagem">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/beneficio-20-off-entrada-dos-noivos.webp" alt="Noivos comemorando a entrada na festa, com a noiva erguendo o buquê e os convidados ao redor" width={1120} height={1400} />  
 </div>  
 <div class="beneficio__conteudo">  
 <span class="rotulo">Condição 02</span>  
 <h2 class="beneficio__titulo">20% OFF<br class="br-desktop"> + 4 cortesias</h2>  
 <p class="beneficio__texto oculto-mobile">Mais benefícios para personalizar diferentes<br class="br-desktop"> momentos do casamento.</p>  
 <p class="beneficio__texto oculto-mobile">Em meses selecionados, além de 20% OFF,<br class="br-desktop"> você escolhe 2 cortesias médias + 2 cortesias<br class="br-desktop"> pequenas, combinando experiências para a<br class="br-desktop"> recepção, pista, gastronomia e decoração.</p>  
 <p class="beneficio__texto so-mobile">Em meses selecionados: 20% OFF<br class="br-mobile"> + 2 cortesias médias e 2 pequenas<br class="br-mobile"> para personalizar a recepção, a pista,<br class="br-mobile"> a gastronomia e a decoração.</p>  
  
 <div class="inclui">  
 <p class="inclui__titulo">A condição inclui:</p>  
 <p class="inclui__principal"><span class="visualmente-oculto">20% OFF</span><span aria-hidden="true"><span class="contador" data-valor="20">20</span>% <span class="destaque-off">OFF</span></span></p>  
 <ul class="inclui__lista">  
 <li><span><span class="inclui__mais">+</span> entrada de 10% no PIX</span></li>  
 <li><span><span class="inclui__mais">+</span> 2 cortesias médias</span> <a class="inclui__link" href="#cortesias-medias">Consulte cortesias</a></li>  
 <li><span><span class="inclui__mais">+</span> 2 cortesias pequenas</span> <a class="inclui__link" href="#cortesias-pequenas">Consulte cortesias</a></li>  
 </ul>  
 </div>  
  
 <a class="botao botao--primario beneficio__cta" href="#contato">Consulte datas disponíveis</a>  
 </div>  
 </div>  
 </section>  
  
 <!-- BENEFÍCIO 3 -->  
 <section class="beneficio beneficio--areia" id="beneficio-16-off">  
 <div class="container beneficio__grade">  
 <div class="beneficio__imagem">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/beneficio-16-off-noivos-no-altar.webp" alt="Noivos abraçados diante de um arco de flores brancas e folhagens iluminado" width={1128} height={1394} />  
 </div>  
 <div class="beneficio__conteudo">  
 <span class="rotulo">Condição 03</span>  
 <h2 class="beneficio__titulo">16% OFF<br class="br-desktop"> + 4 experiências</h2>  
 <p class="beneficio__texto oculto-mobile">Uma combinação que reúne gastronomia, decoração, entretenimento e experiências para os convidados.<br class="br-desktop"> Nesta condição, você recebe 1 cortesia grande<br class="br-desktop"> + 3 cortesias médias, ampliando as possibilidades<br class="br-desktop"> para diferentes momentos da festa.</p>  
 <p class="beneficio__texto so-mobile">16% OFF + 1 cortesia grande e 3 médias, reunindo gastronomia, decoração, entretenimento e experiências para<br class="br-mobile-360"> os convidados.</p>  
  
 <div class="inclui">  
 <p class="inclui__titulo">A condição inclui:</p>  
 <p class="inclui__principal"><span class="visualmente-oculto">16% OFF</span><span aria-hidden="true"><span class="contador" data-valor="16">16</span>% <span class="destaque-off">OFF</span></span></p>  
 <ul class="inclui__lista">  
 <li><span><span class="inclui__mais">+</span> 1 cortesia grande</span> <a class="inclui__link" href="#cortesias-grandes">Consulte cortesias</a></li>  
 <li><span><span class="inclui__mais">+</span> 3 cortesias médias</span> <a class="inclui__link" href="#cortesias-medias">Consulte cortesias</a></li>  
 </ul>  
 </div>  
  
 <a class="botao botao--primario beneficio__cta" href="#contato">Consulte datas disponíveis</a>  
 </div>  
 </div>  
 </section>  
  
 <!-- CORTESIAS �?" no desktop vira abas (G / M / P); no mobile as 3 seções ficam empilhadas -->  
 <div class="cortesias-abas" id="cortesias">  
 <div class="cortesias-abas__topo">  
 <div class="container">  
 <div class="cortesias-abas__cabecalho">  
 <div>  
 <span class="rotulo">Personalize sua condição</span>  
 <h2 class="cortesias-abas__titulo">Conheça as cortesias</h2>  
 </div>  
 <div class="cortesias-abas__setas">  
 <button class="galeria__botao" type="button" data-cortesias="anterior" aria-label="Cortesias anteriores">  
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>  
 </button>  
 <button class="galeria__botao" type="button" data-cortesias="proxima" aria-label="Próximas cortesias">  
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>  
 </button>  
 </div>  
 </div>  
 <div class="cortesias-abas__lista" role="tablist" aria-label="Categorias de cortesias">  
 <button class="cortesias-abas__aba" type="button" role="tab" id="aba-cortesias-grandes" aria-controls="cortesias-grandes" aria-selected="true"><span class="aba-prefixo">Cortesias </span>grandes</button>  
 <button class="cortesias-abas__aba" type="button" role="tab" id="aba-cortesias-medias" aria-controls="cortesias-medias" aria-selected="false"><span class="aba-prefixo">Cortesias </span>médias</button>  
 <button class="cortesias-abas__aba" type="button" role="tab" id="aba-cortesias-pequenas" aria-controls="cortesias-pequenas" aria-selected="false"><span class="aba-prefixo">Cortesias </span>pequenas</button>  
 </div>  
 </div>  
 </div>  
  
 <!-- CORTESIAS GRANDES -->  
 <section class="cortesias" id="cortesias-grandes">  
 <div class="container">  
 <div class="cortesias__cabecalho">  
 <span class="cortesias__selo" aria-hidden="true">G</span>  
 <h2 class="cortesias__titulo">Cortesia grande</h2>  
 </div>  
 <ul class="cortesias__grade">  
 <li class="cortesia">  
 <div class="cortesia__imagem">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/cortesia-g-ilha-de-massas.webp" alt="Rechaud de prata com massa servida na ilha de massas" width={1000} height={667} />  
 </div>  
 <h3 class="cortesia__nome">Ilha de massas</h3>  
 <p class="cortesia__descricao">Uma estação gastronômica para compor o serviço durante a festa.</p>  
 </li>  
 <li class="cortesia">  
 <div class="cortesia__imagem">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/cortesia-g-ilha-gastronomica.webp" alt="Mesa da ilha gastronômica com frutas, doces e torre de profiteroles" width={749} height={1000} />  
 </div>  
 <h3 class="cortesia__nome">Ilha Gastronômica</h3>  
 <p class="cortesia__descricao">Uma estação dedicada a ampliar as opções gastronômicas disponíveis durante a celebração.</p>  
 </li>  
 <li class="cortesia">  
 <div class="cortesia__imagem">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/cortesia-g-estacao-sobremesas-sorvete.webp" alt="Sobremesa com sorvete e casquinha servida sobre gelo seco ao ar livre" width={667} height={1000} />  
 </div>  
 <h3 class="cortesia__nome">Estação de sobremesas com sorvete</h3>  
 <p class="cortesia__descricao">Uma experiência doce para complementar o menu.</p>  
 </li>  
 <li class="cortesia">  
 <div class="cortesia__imagem">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/cortesia-g-adicional-de-peixe.webp" alt="Salmão finalizado com ervas e frutas cítricas" width={749} height={1000} />  
 </div>  
 <h3 class="cortesia__nome">Adicional de peixe no cardápio</h3>  
 <p class="cortesia__descricao">Mais uma opção para enriquecer<br class="br-largo"> a composição gastronômica.</p>  
 </li>  
 <li class="cortesia">  
 <div class="cortesia__imagem">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/cortesia-g-upgrade-decoracao-encanto.webp" alt="Mesa do bolo com arranjos de flores rosas e parede de folhagens" width={667} height={1000} />  
 </div>  
 <h3 class="cortesia__nome">Upgrade de decoração Essence para Encanto</h3>  
 <p class="cortesia__descricao">Uma evolução na proposta decorativa da celebração.</p>  
 </li>  
 </ul>  
 </div>  
 </section>  
  
 <!-- CORTESIAS M�?DIAS -->  
 <section class="cortesias cortesias--quatro" id="cortesias-medias">  
 <div class="container">  
 <div class="cortesias__cabecalho">  
 <span class="cortesias__selo" aria-hidden="true">M</span>  
 <h2 class="cortesias__titulo">Cortesias médias</h2>  
 </div>  
 <ul class="cortesias__grade">  
 <li class="cortesia">  
 <div class="cortesia__imagem">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/cortesia-m-pista-paris-led.webp" alt="Pista de dança iluminada com pontos de LED no salão" width={1000} height={667} />  
 </div>  
