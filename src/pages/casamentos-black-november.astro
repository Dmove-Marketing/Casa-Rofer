---
// Gerado a partir de: black-november.html
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import Video from '../components/ui/Video.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import '../styles/black-november.css';
---

<Base
  title="Black November Casa Rofer | Condições especiais para casamentos em 2027"
  description="Black November Casa Rofer: de 01 a 30 de novembro, datas de 2027 com condições especiais e cortesias exclusivas para casamentos no Brooklin, São Paulo."
  ogImage="https://media.dmove.com.br/clients/casa-rofer/photos/hero-cerimonia-jardim-de-inverno.webp"
  canonical="https://eventos.casarofer.com.br/casamentos-black-november/"
>
<main>  
  
 <!-- HERO -->  
 <section class="hero hero--titulo" id="topo">  
 <div class="hero__imagem">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/hero-cerimonia-jardim-de-inverno.webp" alt="Cerimônia de casamento no jardim de inverno da Casa Rofer, com corredor de flores brancas e cadeiras dos convidados" width={1535} height={1025} priority />  
 </div>  
 <div class="hero__conteudo">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/logo-casa-rofer-areia.webp" alt="Casa Rofer" width={640} height={228} class="hero__logo" />  
 <h1 class="hero__titulo">  
 <span class="hero__titulo-linha">Black</span>  
 <span class="hero__titulo-linha hero__titulo-linha--menor">November</span>  
 <span class="visualmente-oculto">Casa Rofer</span>  
 </h1>  
 <p class="hero__periodo">De 01 a 30 de novembro</p>  
 <p class="hero__publico">Datas selecionadas com condições especiais para o espaço do seu casamento em&nbsp;2027.</p>  
 <a class="botao botao--claro hero__cta" href="#contato">Fale com nossa equipe</a>  
 </div>  
 </section>  
  
 <!-- CONHEÇA A CASA ROFER — texto + vídeo -->
 <section class="conheca" id="conheca" aria-labelledby="conheca-titulo">
 <div class="container conheca__grade">
 <div class="conheca__texto-bloco">
 <h2 class="conheca__titulo" id="conheca-titulo">Conheça a Casa Rofer</h2>
 <p class="conheca__texto">No coração do Brooklin, a Casa Rofer reúne arquitetura marcante, sofisticação e uma atmosfera única para grandes celebrações. Dois ambientes integrados, até 250&nbsp;convidados e uma solução 360°, com estrutura, gastronomia e operação em um só&nbsp;lugar. Um espaço contemporâneo e versátil, pensado para receber casamentos e eventos que pedem uma experiência à altura da&nbsp;ocasião.</p>
 </div>
 <div class="conheca__video">
 <!-- Vídeo hospedado no próprio site (public/videos); URL absoluta para o JSON-LD do Google -->
 <Video src={new URL('/videos/conheca-casa-rofer.mp4', Astro.url).href} poster={new URL('/videos/conheca-casa-rofer-capa.webp', Astro.url).href} title="Conheça a Casa Rofer" description="Conheça a Casa Rofer, espaço sofisticado para casamentos e eventos no Brooklin, São Paulo." uploadDate="2026-10-07" duration="PT1M48S" autoplay />
 </div>
 </div>
 </section>

 <!-- GALERIA — mosaico; clique amplia a foto -->  
 <section class="galeria" id="galeria" aria-labelledby="galeria-titulo">  
 <div class="container">  
 <div class="galeria__cabecalho">  
 <h2 class="galeria__titulo" id="galeria-titulo">Celebrações que já<br class="br-desktop"> ganharam vida na Casa Rofer</h2>  
 </div>  
 <ul class="mosaico" aria-label="Fotos de casamentos na Casa Rofer">  
 <li class="mosaico__foto mosaico__foto--vertical mosaico__foto--grande">  
 <button class="mosaico__botao" type="button" data-legenda="Saída da cerimônia" aria-label="Ampliar foto: Saída da cerimônia">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-01-saida-da-cerimonia.webp" alt="Noivos comemorando a saída da cerimônia sob arco de flores, aplaudidos pelos convidados" width={933} height={1400} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--alta mosaico__foto--vertical">  
 <button class="mosaico__botao" type="button" data-legenda="Fachada da Casa Rofer" aria-label="Ampliar foto: Fachada da Casa Rofer">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-05-fachada-casa-rofer.webp" alt="Fachada da Casa Rofer com jardineira de flores, letreiro e entrada principal iluminada" width={933} height={1400} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--alta mosaico__foto--vertical">  
 <button class="mosaico__botao" type="button" data-legenda="Salão com telão e mesas postas" aria-label="Ampliar foto: Salão com telão e mesas postas">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-06-salao-com-telao-e-mesa-posta.webp" alt="Salão com telão exibindo foto dos noivos e mesa redonda posta com arranjo de flores" width={933} height={1400} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--larga">  
 <button class="mosaico__botao" type="button" data-legenda="Cerimônia no jardim de inverno" aria-label="Ampliar foto: Cerimônia no jardim de inverno">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-03-cerimonia-montada-jardim-de-inverno.webp" alt="Cerimônia montada no jardim de inverno, com cadeiras de palhinha, arranjos de flores brancas e arco floral" width={1400} height={933} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--vertical mosaico__foto--alta">  
 <button class="mosaico__botao" type="button" data-legenda="Primeira dança na pista de LED" aria-label="Ampliar foto: Primeira dança na pista de LED">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-02-primeira-danca-pista-led.webp" alt="Primeira dança dos noivos na pista de LED cercada pelos convidados" width={1128} height={1394} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--vertical mosaico__foto--alta">  
 <button class="mosaico__botao" type="button" data-legenda="A dança dos noivos" aria-label="Ampliar foto: A dança dos noivos">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-04-danca-dos-noivos.webp" alt="Noivo inclinando a noiva durante a dança no salão" width={1120} height={1400} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--larga">  
 <button class="mosaico__botao" type="button" data-legenda="Salão com escada" aria-label="Ampliar foto: Salão com escada">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-10-salao-com-escada.webp" alt="Salão com piso de madeira, escada, paredes de tijolo e mesas redondas montadas" width={1400} height={933} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--larga">  
 <button class="mosaico__botao" type="button" data-legenda="Jardim de inverno" aria-label="Ampliar foto: Jardim de inverno">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-08-salao-jardim-de-inverno.webp" alt="Salão jardim de inverno da Casa Rofer montado para casamento" width={1400} height={933} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--larga">  
 <button class="mosaico__botao" type="button" data-legenda="Lounge do salão" aria-label="Ampliar foto: Lounge do salão">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-11-lounge-do-salao.webp" alt="Lounge do salão com sofás, piso de madeira e iluminação quente nas cortinas" width={1400} height={933} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--vertical mosaico__foto--grande">  
 <button class="mosaico__botao" type="button" data-legenda="O brinde" aria-label="Ampliar foto: O brinde">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-07-brinde-com-convidados.webp" alt="Noivos brindando com os convidados à mesa" width={1052} height={1400} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--larga">  
 <button class="mosaico__botao" type="button" data-legenda="Mesa de doces com flores" aria-label="Ampliar foto: Mesa de doces com flores">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-12-mesa-de-doces-com-flores.webp" alt="Mesa de doces decorada com arranjos de flores laranja e vermelhas diante da parede de pedra" width={1400} height={1000} />  
 </button>  
 </li>  
 <li class="mosaico__foto mosaico__foto--larga">  
 <button class="mosaico__botao" type="button" data-legenda="Salão parede verde" aria-label="Ampliar foto: Salão parede verde">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-09-salao-parede-verde.webp" alt="Salão com parede verde, teto de vidro e mesas montadas para o casamento" width={1400} height={933} />  
 </button>  
 </li>  
 </ul>  
 </div>  
 </section>  
  
 <div class="ampliada" role="dialog" aria-modal="true" aria-label="Foto ampliada" aria-hidden="true">  
 <button class="galeria__botao ampliada__fechar" type="button" aria-label="Fechar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>  
 <div class="ampliada__palco"><Img src="placeholder.jpg" alt="" /></div>  
 </div>  
  
 <!-- SOBRE / CONDIÇÕES -->  
 <section class="sobre" id="condicoes">  
 <div class="container">  
 <span class="rotulo">Black November 2026</span>  
 <h2 class="sobre__titulo">Escolha a condição<br class="br-desktop"><br class="br-mobile"> ideal para a sua data</h2>  
 <p class="sobre__texto sobre__texto--campanha">A Black November Casa Rofer é uma oportunidade para planejar seu casamento em&nbsp;2027 e conhecer as possibilidades para a sua celebração. Consulte a disponibilidade da agenda e descubra as condições especiais para a data escolhida. A Casa Rofer realiza um evento por dia: quando uma data é reservada, ela deixa de estar disponível.</p>
 <p class="sobre__aviso">Condições vinculadas à contratação durante a campanha e às condições de disponibilidade.</p>
 </div>  
 </section>  
  
 <!-- BENEFÍCIO 1 -->  
 <section class="beneficio beneficio--areia" id="beneficio-25-off">  
 <div class="container beneficio__grade">  
 <div class="beneficio__imagem">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/beneficio-25-off-cerimonia.webp" alt="Noivos no altar durante a cerimônia no jardim de inverno, cercados por arranjos de flores brancas e convidados" width={1400} height={933} />  
 </div>  
 <div class="beneficio__conteudo">  
 <span class="rotulo">Condição 01</span>  
 <h2 class="beneficio__titulo beneficio__titulo--compacto">Planeje<br class="br-desktop"> seu casamento<br class="br-desktop"> para&nbsp;2027</h2>  
 <p class="beneficio__texto beneficio__texto--campanha">Durante novembro, datas selecionadas de 2027<br class="br-desktop"> na Casa Rofer contam com condições especiais<br class="br-desktop"> de pagamento. Dois ambientes integrados,<br class="br-desktop"> até 250&nbsp;convidados e uma solução 360°,<br class="br-desktop"> reunindo estrutura, gastronomia e operação<br class="br-desktop"> em um só&nbsp;lugar.</p>  
 <p class="beneficio__aviso">Condições vinculadas à contratação durante a campanha e às condições de disponibilidade.</p>  
 <a class="botao botao--primario beneficio__cta" href="#contato">Agende uma visita</a>  
 </div>  
 </div>  
 </section>  
  
 <!-- BENEFÍCIO 2 -->  
 <section class="beneficio beneficio--invertido" id="beneficio-20-off">  
 <div class="container beneficio__grade">  
 <div class="beneficio__imagem">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/beneficio-20-off-entrada-dos-noivos.webp" alt="Noivos comemorando a entrada na festa, com a noiva erguendo o buquê e os convidados ao redor" width={1120} height={1400} />  
 </div>  
 <div class="beneficio__conteudo">  
 <span class="rotulo">Condição 02</span>  
 <h2 class="beneficio__titulo beneficio__titulo--compacto">Personalize a celebração<br class="br-desktop"> do seu&nbsp;jeito</h2>  
 <p class="beneficio__texto beneficio__texto--campanha">Casamentos contratados durante o mês recebem<br class="br-desktop"> uma estação gastronômica exclusiva do Buffet Rofer,<br class="br-desktop"> cortesia da casa. Uma experiência que traduz mais<br class="br-desktop"> de três décadas de excelência gastronômica e<br class="br-desktop"> valoriza ainda mais a celebração de&nbsp;vocês.</p>  
 <p class="beneficio__aviso">Condições vinculadas à contratação durante a campanha e às condições de disponibilidade.</p>  
 <a class="botao botao--primario beneficio__cta" href="#contato">Solicite orçamento</a>  
 </div>  
 </div>  
 </section>  
  
 <!-- BENEFÍCIO 3 -->  
 <section class="beneficio beneficio--areia" id="beneficio-16-off">  
 <div class="container beneficio__grade">  
 <div class="beneficio__imagem">  
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/beneficio-16-off-noivos-no-altar.webp" alt="Noivos abraçados diante de um arco de flores brancas e folhagens iluminado" width={1128} height={1394} />  
 </div>  
 <div class="beneficio__conteudo">  
 <span class="rotulo">Condição 03</span>  
 <h2 class="beneficio__titulo beneficio__titulo--compacto">Mais possibilidades para&nbsp;celebrar</h2>  
 <p class="beneficio__texto beneficio__texto--campanha">Datas selecionadas de 2027 com condições especiais<br class="br-desktop"> de pagamento e experiências gastronômicas exclusivas.<br class="br-desktop"> Se vocês ainda estão procurando o espaço ideal para o<br class="br-desktop"> casamento, essa pode ser a oportunidade de encontrar<br class="br-desktop"> o lugar certo para&nbsp;celebrar.</p>  
 <p class="beneficio__aviso">Condições vinculadas à contratação durante a campanha e às condições de disponibilidade.</p>  
 <a class="botao botao--primario beneficio__cta" href="#contato">Fale com nossa equipe</a>  
 </div>  
 </div>  
 </section>  
  
 <!-- EXPERIÊNCIA — tipos de cortesia em ícones -->
 <section class="experiencia" id="experiencia" aria-labelledby="experiencia-titulo">
 <div class="container">
 <span class="rotulo">Detalhes que encantam</span>
 <h2 class="experiencia__titulo" id="experiencia-titulo">Personalize sua experiência</h2>
 <p class="experiencia__texto">Cada casamento é único, e a experiência também pode ser. Encontre as cortesias que mais combinam com a sua&nbsp;celebração.</p>
 <ul class="experiencia__lista">
 <li class="experiencia__item" style="--i:0"><span class="experiencia__icone"><svg class="experiencia__svg" viewBox="-3 -3 102 102" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="exp-anel"><circle class="exp-traco" cx="48" cy="48" r="46" pathLength="1"/><circle class="exp-traco exp-anel-interno" cx="48" cy="48" r="40.5" pathLength="1"/><path class="exp-losango" d="M48 -0.6l2.6 2.6-2.6 2.6-2.6-2.6z"/></g><g class="exp-desenho"><g class="exp-ajuste" transform="translate(48 48) scale(0.978) translate(-47.35 -48.62)" style="--traco: 1.18"><path class="exp-traco" pathLength="1" d="M39.5 33.5c0 6.6 3.8 10.5 8.5 10.5s8.5-3.9 8.5-10.5"/><path class="exp-traco" pathLength="1" d="M39.5 33.5c2.6-4.4 6-5.4 8.5-3c2.5-2.4 5.9-1.4 8.5 3"/><path class="exp-traco" pathLength="1" d="M44.2 33c1.2-2.8 6.4-2.8 7.6 0"/><path class="exp-traco" pathLength="1" d="M43.5 37.5c1.6 2.3 7.4 2.3 9 0"/><path class="exp-traco" pathLength="1" d="M48 44v24"/><path class="exp-traco" pathLength="1" d="M48 55.5c-5.5-.6-8.8-3.8-9.8-8.6 5.5.2 8.8 3.4 9.8 8.6z"/><path class="exp-traco" pathLength="1" d="M48 61c4.8-.8 7.6-3.6 8.4-7.8-4.8.4-7.6 3.2-8.4 7.8z"/></g></g></svg></span><span class="experiencia__nome">Decoração</span></li>
 <li class="experiencia__item" style="--i:1"><span class="experiencia__icone"><svg class="experiencia__svg" viewBox="-3 -3 102 102" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="exp-anel"><circle class="exp-traco" cx="48" cy="48" r="46" pathLength="1"/><circle class="exp-traco exp-anel-interno" cx="48" cy="48" r="40.5" pathLength="1"/><path class="exp-losango" d="M48 -0.6l2.6 2.6-2.6 2.6-2.6-2.6z"/></g><g class="exp-desenho"><g class="exp-ajuste" transform="translate(48 48) scale(0.778) translate(-48.25 -41.00)" style="--traco: 1.48"><path class="exp-traco" pathLength="1" d="M48 21v9"/><circle class="exp-traco" pathLength="1" cx="48" cy="44" r="14"/><path class="exp-traco" pathLength="1" d="M48 30c-5 3.6-7 8.4-7 14s2 10.4 7 14"/><path class="exp-traco" pathLength="1" d="M48 30c5 3.6 7 8.4 7 14s-2 10.4-7 14"/><path class="exp-traco" pathLength="1" d="M48 30v28"/><path class="exp-traco" pathLength="1" d="M35.3 38.5c8.3 2.2 17.1 2.2 25.4 0"/><path class="exp-traco" pathLength="1" d="M34 44h28"/><path class="exp-traco" pathLength="1" d="M35.3 49.5c8.3-2.2 17.1-2.2 25.4 0"/><path class="exp-traco" pathLength="1" d="M31 24v7"/><path class="exp-traco" pathLength="1" d="M27.5 27.5h7"/><path class="exp-traco" pathLength="1" d="M66 55v6"/><path class="exp-traco" pathLength="1" d="M63 58h6"/></g></g></svg></span><span class="experiencia__nome">Audiovisual</span></li>
