---
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import Video from '../components/ui/Video.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import '../styles/black-november.css';
---

<Base
  title="Black November Casa Rofer | Condições especiais para debutantes em 2027"
  description="Black November Casa Rofer: de 01 a 30 de novembro, datas de 2027 com condições especiais e cortesias para festas de 15 anos no Brooklin, São Paulo."
  ogImage="https://media.dmove.com.br/clients/casa-rofer/photos/hero-valsa-com-o-pai-pista-led.webp"
  canonical="https://eventos.casarofer.com.br/debutantes-black-november/"
>
<main>

 <!-- HERO -->
 <section class="hero hero--titulo hero--debutante" id="topo">
 <div class="hero__imagem">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/hero-valsa-com-o-pai-pista-led.webp" alt="Debutante valsa com o pai na pista de LED da Casa Rofer, no Brooklin, São Paulo" width={1536} height={1024} priority />
 </div>
 <div class="hero__conteudo">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/logo-casa-rofer-areia.webp" alt="Casa Rofer" width={640} height={228} class="hero__logo" />
 <h1 class="hero__titulo">
 <span class="hero__titulo-linha">Black</span>
 <span class="hero__titulo-linha hero__titulo-linha--menor">November</span>
 <span class="visualmente-oculto">Casa Rofer</span>
 </h1>
 <p class="hero__periodo">De 01 a 30 de novembro</p>
 <p class="hero__publico">Datas selecionadas com condições especiais para celebrar seus 15&nbsp;anos em um espaço exclusivo em&nbsp;2027.</p>
 <a class="botao botao--claro hero__cta" href="#contato">Fale com nossa equipe</a>
 </div>
 </section>

 <!-- CONHEÇA A CASA ROFER — texto + vídeo -->
 <section class="conheca" id="conheca" aria-labelledby="conheca-titulo">
 <div class="container conheca__grade">
 <div class="conheca__texto-bloco">
 <h2 class="conheca__titulo" id="conheca-titulo">Conheça a Casa Rofer</h2>
 <p class="conheca__texto conheca__texto--quebras">No coração do Brooklin, a Casa Rofer<br class="br-desktop"> reúne arquitetura marcante, sofisticação<br class="br-desktop"> e uma atmosfera única para grandes celebrações.<br class="br-desktop"> Dois ambientes integrados, até&nbsp;250&nbsp;convidados<br class="br-desktop"> e uma solução 360°, com estrutura, gastronomia<br class="br-desktop"> e operação em um só&nbsp;lugar.<br class="br-desktop"> Um espaço contemporâneo e versátil,<br class="br-desktop"> pensado para transformar sua festa<br class="br-desktop"> de 15&nbsp;anos em uma noite&nbsp;inesquecível.</p>
 </div>
 <div class="conheca__video">
 <Video src={new URL('/videos/conheca-casa-rofer.mp4', Astro.url).href} poster={new URL('/videos/conheca-casa-rofer-capa.webp', Astro.url).href} title="Conheça a Casa Rofer" description="Conheça a Casa Rofer, espaço sofisticado para festas de debutante e eventos no Brooklin, São Paulo." uploadDate="2026-10-07" duration="PT1M48S" autoplay />
 </div>
 </div>
 </section>

 <!-- GALERIA — mosaico; clique amplia a foto -->
 <section class="galeria" id="galeria" aria-labelledby="galeria-titulo">
 <div class="container">
 <div class="galeria__cabecalho">
 <h2 class="galeria__titulo" id="galeria-titulo">Sonhos que já ganharam<br class="br-desktop"> vida na Casa Rofer</h2>
 </div>
 <ul class="mosaico mosaico--debutante" aria-label="Fotos de festas de 15 anos na Casa Rofer">
 <li class="mosaico__foto mosaico__foto--alta mosaico__foto--vertical">
 <button class="mosaico__botao" type="button" data-legenda="Debutante com o bolo" aria-label="Ampliar foto: Debutante com o bolo">
 <Img src="galeria-debutante/debutante-com-o-bolo.webp" alt="Debutante de vestido azul e tiara sorrindo atrás do bolo branco de quatro andares, entre flores brancas" width={934} height={1400} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--larga">
 <button class="mosaico__botao" type="button" data-legenda="Tambores na pista" aria-label="Ampliar foto: Tambores na pista">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-02-tambores-na-pista.webp" alt="Debutante e amigas tocando tambores iluminados na pista, diante do painel de LED" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--alta mosaico__foto--vertical">
 <button class="mosaico__botao" type="button" data-legenda="Debutante na escada" aria-label="Ampliar foto: Debutante na escada">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-04-debutante-na-escada.webp" alt="Debutante de vestido vermelho e tiara descendo a escada decorada com flores" width={933} height={1400} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--larga">
 <button class="mosaico__botao" type="button" data-legenda="Maquiagem da debutante" aria-label="Ampliar foto: Maquiagem da debutante">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-07-maquiagem-da-debutante.webp" alt="Debutante de tiara sendo maquiada antes da festa" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--grande">
 <button class="mosaico__botao" type="button" data-legenda="Dança com as amigas" aria-label="Ampliar foto: Dança com as amigas">
 <Img src="galeria-debutante/danca-com-as-amigas.webp" alt="Debutante e amigas de vestidos prateados dançando na pista sob luzes azuis e chuva de papel picado" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--larga">
 <button class="mosaico__botao" type="button" data-legenda="Salão com mesas postas" aria-label="Ampliar foto: Salão com mesas postas">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-08-salao-com-mesas-postas.webp" alt="Salão com mesas redondas postas, arranjos de flores vermelhas e iluminação quente" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--larga">
 <button class="mosaico__botao" type="button" data-legenda="Debutante entre flores" aria-label="Ampliar foto: Debutante entre flores">
 <Img src="galeria-debutante/debutante-entre-flores.webp" alt="Debutante de vestido prateado no corredor de árvores de flores brancas iluminadas" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--alta mosaico__foto--vertical">
 <button class="mosaico__botao" type="button" data-legenda="Fachada da Casa Rofer" aria-label="Ampliar foto: Fachada da Casa Rofer">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-05-fachada-casa-rofer.webp" alt="Fachada da Casa Rofer com jardineira de flores, letreiro e entrada principal iluminada" width={933} height={1400} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--alta mosaico__foto--vertical">
 <button class="mosaico__botao" type="button" data-legenda="Doces com flores" aria-label="Ampliar foto: Doces com flores">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-06-doces-com-flores.webp" alt="Doces finos em bandeja de prata entre arranjos de flores" width={933} height={1400} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--grande">
 <button class="mosaico__botao" type="button" data-legenda="Parabéns com a família" aria-label="Ampliar foto: Parabéns com a família">
 <Img src="galeria-debutante/parabens-com-a-familia.webp" alt="Debutante de vestido azul ao lado do bolo de 15 anos, aplaudida pela família diante do telão" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--larga">
 <button class="mosaico__botao" type="button" data-legenda="Salão com pista de LED" aria-label="Ampliar foto: Salão com pista de LED">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-10-salao-com-pista-led.webp" alt="Salão com pista de LED, bar e painéis coloridos iluminados" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--larga">
 <button class="mosaico__botao" type="button" data-legenda="Bar com bartenders" aria-label="Ampliar foto: Bar com bartenders">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-11-bar-com-bartenders.webp" alt="Bar iluminado com bartenders e arranjos de flores diante das cortinas" width={1400} height={933} />
 </button>
 </li>
 </ul>
 </div>
 </section>

 <div class="ampliada" role="dialog" aria-modal="true" aria-label="Foto ampliada" aria-hidden="true">
 <button class="galeria__botao ampliada__fechar" type="button" aria-label="Fechar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
 <div class="ampliada__palco"><Img src="placeholder.jpg" alt="" /></div>
 </div>

 <!-- SOBRE / CONDIÇÕES -->
 <section class="sobre" id="condicoes">
 <div class="container">
 <span class="rotulo">Black November 2026</span>
 <h2 class="sobre__titulo">Escolha a condição<br class="br-desktop"><br class="br-mobile"> ideal para a sua data</h2>
 <p class="sobre__texto sobre__texto--campanha">A Black November Casa Rofer é uma oportunidade para planejar sua festa de debutante em&nbsp;2027 e conhecer as possibilidades para essa celebração. Consulte a disponibilidade da agenda e descubra as condições especiais para a data escolhida. A&nbsp;Casa Rofer realiza um evento por dia: quando uma data é reservada, ela deixa de estar&nbsp;disponível.</p>
 <p class="sobre__aviso">Condições vinculadas à contratação durante a campanha e à disponibilidade da data&nbsp;escolhida.</p>
 </div>
 </section>

 <!-- BENEFÍCIO 1 -->
 <section class="beneficio beneficio--areia" id="beneficio-25-off">
 <div class="container beneficio__grade">
 <div class="beneficio__imagem">
 <Img src="beneficios-debutante/debutante-beneficio-01.webp" alt="Debutante de vestido azul brilhante e tiara sentada no chão diante da mesa do bolo, entre velas e flores brancas" width={1400} height={933} />
 </div>
 <div class="beneficio__conteudo">
 <span class="rotulo">Condição 01</span>
 <h2 class="beneficio__titulo beneficio__titulo--compacto">Planeje sua festa<br class="br-desktop"> de debutante<br class="br-desktop"> para&nbsp;2027</h2>
 <p class="beneficio__texto beneficio__texto--campanha">Durante novembro, datas selecionadas de 2027<br class="br-desktop"> na Casa Rofer contam com condições especiais<br class="br-desktop"> de pagamento. Dois ambientes integrados,<br class="br-desktop"> capacidade para até&nbsp;250&nbsp;convidados e uma<br class="br-desktop"> solução 360°, reunindo estrutura, gastronomia<br class="br-desktop"> e operação para celebrar esse&nbsp;momento.</p>
 <p class="beneficio__aviso">Condições vinculadas à contratação durante a campanha e à disponibilidade da data&nbsp;escolhida.</p>
 <a class="botao botao--primario beneficio__cta" href="#contato">Agende uma visita</a>
 </div>
 </div>
 </section>

 <!-- BENEFÍCIO 2 -->
 <section class="beneficio beneficio--invertido" id="beneficio-20-off">
 <div class="container beneficio__grade">
 <div class="beneficio__imagem">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/beneficio-20-off-debutante-com-plumas.webp" alt="Debutante com plumas em traje de festa na Casa Rofer" width={933} height={1400} />
 </div>
 <div class="beneficio__conteudo">
 <span class="rotulo">Condição 02</span>
 <h2 class="beneficio__titulo beneficio__titulo--compacto">Personalize a festa<br class="br-desktop"> do seu&nbsp;jeito</h2>
 <p class="beneficio__texto beneficio__texto--campanha">As festas de debutante contratadas durante o mês recebem uma estação gastronômica exclusiva do Buffet Rofer, como cortesia da casa. Uma experiência que traduz mais de três décadas de excelência gastronômica e torna a&nbsp;comemoração ainda mais&nbsp;especial.</p>
 <p class="beneficio__aviso">Condições vinculadas à contratação durante a campanha e à disponibilidade da data&nbsp;escolhida.</p>
 <a class="botao botao--primario beneficio__cta" href="#contato">Solicite orçamento</a>
 </div>
 </div>
 </section>

 <!-- BENEFÍCIO 3 -->
 <section class="beneficio beneficio--areia beneficio--debutante" id="beneficio-16-off">
 <div class="container beneficio__grade">
 <div class="beneficio__imagem">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/beneficio-16-off-debutante-mesa-de-flores.webp" alt="Debutante diante de mesa com arranjo de flores na Casa Rofer" width={933} height={1400} />
 </div>
 <div class="beneficio__conteudo">
 <span class="rotulo">Condição 03</span>
 <h2 class="beneficio__titulo beneficio__titulo--compacto">Mais possibilidades para&nbsp;celebrar</h2>
 <p class="beneficio__texto beneficio__texto--campanha">Datas selecionadas de 2027 com condições especiais de pagamento e experiências gastronômicas exclusivas. Se você ainda está procurando o espaço ideal para sua festa de debutante, essa pode ser a&nbsp;oportunidade de encontrar o lugar certo para comemorar esse momento com família e&nbsp;amigos.</p>
 <p class="beneficio__aviso">Condições vinculadas à contratação durante a campanha e à disponibilidade da data&nbsp;escolhida.</p>
 <a class="botao botao--primario beneficio__cta" href="#contato">Fale com nossa equipe</a>
 </div>
 </div>
 </section>

 <!-- EXPERIÊNCIA — tipos de cortesia em ícones -->
 <section class="experiencia" id="experiencia" aria-labelledby="experiencia-titulo">
 <div class="container">
 <span class="rotulo">Detalhes que encantam</span>
 <h2 class="experiencia__titulo" id="experiencia-titulo">Personalize sua experiência</h2>
 <p class="experiencia__texto">Cada festa tem seu estilo, e as cortesias podem acompanhar o que você imaginou para essa comemoração. Encontre as opções que mais combinam com a sua&nbsp;festa.</p>
 <ul class="experiencia__lista">
 <li class="experiencia__item" style="--i:0"><span class="experiencia__icone"><svg class="experiencia__svg" viewBox="-3 -3 102 102" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="exp-anel"><circle class="exp-traco" cx="48" cy="48" r="46" pathLength="1"/><circle class="exp-traco exp-anel-interno" cx="48" cy="48" r="40.5" pathLength="1"/><path class="exp-losango" d="M48 -0.6l2.6 2.6-2.6 2.6-2.6-2.6z"/></g><g class="exp-desenho"><g class="exp-ajuste" transform="translate(48 48) scale(0.850) translate(-48.00 -46.90)" style="--traco: 1.36"><path class="exp-traco" pathLength="1" d="M27 60c13-5 29-5 42 0"/><path class="exp-traco" pathLength="1" d="M41 56.5c0-8 3-14 7-18 4 4 7 10 7 18"/><path class="exp-traco" pathLength="1" d="M30 58.8c.5-5 3-9 6.5-10.5 2.8 1.4 4.6 4 4.5 8"/><path class="exp-traco" pathLength="1" d="M66 58.8c-.5-5-3-9-6.5-10.5-2.8 1.4-4.6 4-4.5 8"/><path class="exp-traco" pathLength="1" d="M48 45c-2 2.3-2.5 4-2.5 5.3a2.5 2.5 0 0 0 5 0c0-1.3-.5-3-2.5-5.3z"/><circle class="exp-traco" pathLength="1" cx="48" cy="35.2" r="1.4"/><circle class="exp-traco" pathLength="1" cx="36.5" cy="45.4" r="1.1"/><circle class="exp-traco" pathLength="1" cx="59.5" cy="45.4" r="1.1"/></g></g></svg></span><span class="experiencia__nome">Decoração</span></li>
 <li class="experiencia__item" style="--i:1"><span class="experiencia__icone"><svg class="experiencia__svg" viewBox="-3 -3 102 102" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="exp-anel"><circle class="exp-traco" cx="48" cy="48" r="46" pathLength="1"/><circle class="exp-traco exp-anel-interno" cx="48" cy="48" r="40.5" pathLength="1"/><path class="exp-losango" d="M48 -0.6l2.6 2.6-2.6 2.6-2.6-2.6z"/></g><g class="exp-desenho"><g class="exp-ajuste" transform="translate(48 48) scale(0.913) translate(-48.00 -44.00)" style="--traco: 1.26"><rect class="exp-traco" pathLength="1" x="41" y="24" width="14" height="20" rx="7"/><path class="exp-traco" pathLength="1" d="M41.5 30h13"/><path class="exp-traco" pathLength="1" d="M41 34h14"/><path class="exp-traco" pathLength="1" d="M41.5 38h13"/><path class="exp-traco" pathLength="1" d="M37 36v2a11 11 0 0 0 22 0v-2"/><path class="exp-traco" pathLength="1" d="M48 49v13"/><path class="exp-traco" pathLength="1" d="M40 64h16"/></g></g></svg></span><span class="experiencia__nome">Audiovisual</span></li>
 <li class="experiencia__item" style="--i:2"><span class="experiencia__icone"><svg class="experiencia__svg" viewBox="-3 -3 102 102" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="exp-anel"><circle class="exp-traco" cx="48" cy="48" r="46" pathLength="1"/><circle class="exp-traco exp-anel-interno" cx="48" cy="48" r="40.5" pathLength="1"/><path class="exp-losango" d="M48 -0.6l2.6 2.6-2.6 2.6-2.6-2.6z"/></g><g class="exp-desenho"><g class="exp-ajuste" transform="translate(48 48) scale(1.065) translate(-48.00 -48.70)" style="--traco: 1.08"><path class="exp-traco" pathLength="1" d="M33 34h30c0 8-6.5 12-15 12s-15-4-15-12z"/><path class="exp-traco" pathLength="1" d="M35.6 38.5h24.8"/><path class="exp-traco" pathLength="1" d="M48 46v15"/><path class="exp-traco" pathLength="1" d="M41 63.5c2-1.6 4.5-2.5 7-2.5s5 .9 7 2.5"/></g></g></svg></span><span class="experiencia__nome">Bar</span></li>
 <li class="experiencia__item" style="--i:3"><span class="experiencia__icone"><svg class="experiencia__svg" viewBox="-3 -3 102 102" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="exp-anel"><circle class="exp-traco" cx="48" cy="48" r="46" pathLength="1"/><circle class="exp-traco exp-anel-interno" cx="48" cy="48" r="40.5" pathLength="1"/><path class="exp-losango" d="M48 -0.6l2.6 2.6-2.6 2.6-2.6-2.6z"/></g><g class="exp-desenho"><g class="exp-ajuste" transform="translate(48 48) scale(0.878) translate(-48.00 -46.20)" style="--traco: 1.32"><rect class="exp-traco" pathLength="1" x="40" y="34" width="16" height="11" rx="1"/><rect class="exp-traco" pathLength="1" x="34" y="45" width="28" height="13" rx="1"/><path class="exp-traco" pathLength="1" d="M34 50.5h28"/><path class="exp-traco" pathLength="1" d="M30 58h36"/><path class="exp-traco" pathLength="1" d="M48 58v5.5"/><path class="exp-traco" pathLength="1" d="M42 64.5c2-1.3 4-1.7 6-1.7s4 .4 6 1.7"/><path class="exp-traco" pathLength="1" d="M48 34c-1.6-2.4-1-4.6 0-6 1 1.4 1.6 3.6 0 6z"/></g></g></svg></span><span class="experiencia__nome">Gastronomia</span></li>
 <li class="experiencia__item" style="--i:4"><span class="experiencia__icone"><svg class="experiencia__svg" viewBox="-3 -3 102 102" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="exp-anel"><circle class="exp-traco" cx="48" cy="48" r="46" pathLength="1"/><circle class="exp-traco exp-anel-interno" cx="48" cy="48" r="40.5" pathLength="1"/><path class="exp-losango" d="M48 -0.6l2.6 2.6-2.6 2.6-2.6-2.6z"/></g><g class="exp-desenho"><g class="exp-ajuste" transform="translate(48 48) scale(0.799) translate(-48.00 -47.50)" style="--traco: 1.45"><rect class="exp-traco" pathLength="1" x="26" y="36" width="44" height="26" rx="3"/><path class="exp-traco" pathLength="1" d="M31 36v-3h9v3"/><path class="exp-traco" pathLength="1" d="M60 36v-2h4v2"/><circle class="exp-traco" pathLength="1" cx="52" cy="49.5" r="8.5"/><circle class="exp-traco" pathLength="1" cx="52" cy="49.5" r="5"/><rect class="exp-traco" pathLength="1" x="31" y="40" width="8" height="5" rx="1"/></g></g></svg></span><span class="experiencia__nome">Foto</span></li>
 <li class="experiencia__item" style="--i:5"><span class="experiencia__icone"><svg class="experiencia__svg" viewBox="-3 -3 102 102" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="exp-anel"><circle class="exp-traco" cx="48" cy="48" r="46" pathLength="1"/><circle class="exp-traco exp-anel-interno" cx="48" cy="48" r="40.5" pathLength="1"/><path class="exp-losango" d="M48 -0.6l2.6 2.6-2.6 2.6-2.6-2.6z"/></g><g class="exp-desenho"><g class="exp-ajuste" transform="translate(48 48) scale(0.713) translate(-51.95 -44.05)" style="--traco: 1.62"><rect class="exp-traco" pathLength="1" x="34" y="24" width="28" height="3.5" rx="1"/><rect class="exp-traco" pathLength="1" x="34" y="64.5" width="28" height="3.5" rx="1"/><path class="exp-traco" pathLength="1" d="M36.5 27.5v37"/><path class="exp-traco" pathLength="1" d="M59.5 27.5v37"/><path class="exp-traco" pathLength="1" d="M41.5 27.5c0 9.5 5.5 12 5.5 18.5s-5.5 9-5.5 18.5"/><path class="exp-traco" pathLength="1" d="M54.5 27.5c0 9.5-5.5 12-5.5 18.5s5.5 9 5.5 18.5"/><path class="exp-traco" pathLength="1" d="M43.5 33h9"/><path class="exp-traco" pathLength="1" d="M43 64.5c1-3.5 3-5 5-5.5 2 .5 4 2 5 5.5"/><path class="exp-traco" pathLength="1" d="M67 20v6"/><path class="exp-traco" pathLength="1" d="M64 23h6"/></g></g></svg></span><span class="experiencia__nome">Hora adicional<br> de celebração</span></li>
 </ul>
