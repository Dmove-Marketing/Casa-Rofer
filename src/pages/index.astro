---
// Gerado a partir de: index.html
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import Video from '../components/ui/Video.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import '../styles/index.css';
---

<Base
  title="Casa Rofer — Espaço de eventos e casamentos | Brooklin, São Paulo"
  description="Mais do que um casamento, uma celebração impecável em cada detalhe. Dois salões exclusivos para até 400 convidados no coração do Brooklin, São Paulo."
  ogImage="/images/og-index.jpg"
>
<!-- ===== HERO ===== -->
<header class="hero" id="top">
  <div class="hero-bg"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/hero-casamento.webp" alt="Celebração na Casa Rofer, Brooklin — São Paulo" priority /></div>
  <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/logo-white.webp" alt="Casa Rofer" class="hero-logo" />
  <div class="hero-inner">
    <p class="hero-sub reveal in">Brooklin&nbsp; · &nbsp;São Paulo</p>
    <div class="hero-divider reveal in d1"></div>
    <h1 class="reveal in d2">Mais do que <span class="accent">um casamento</span>,<br>uma celebração impecável<br>em&nbsp;cada&nbsp;detalhe</h1>
    <div class="hero-cta reveal in d3">
      <a href="#contato" class="btn white">Solicite orçamento</a>
    </div>
  </div>
</header>

<!-- ===== AUTORIDADE ===== -->
<section class="authority">
  <div class="wrap">
    <div class="stat reveal"><b>2 ambientes integrados</b></div>
    <div class="sep"></div>
    <div class="stat reveal d1"><b>Até 250 convidados</b></div>
    <div class="sep"></div>
    <div class="stat reveal d2"><b>Localização estratégica</b></div>
  </div>
</section>

<!-- ===== SOBRE ===== -->
<section id="sobre" class="pad">
  <div class="wrap center">
    <p class="eyebrow reveal">A Casa Rofer</p>
    <h2 class="section-title center reveal d1" style="max-width:33ch">Um espaço onde <br class="br-mobile">arquitetura, <br class="br-desktop">hospitalidade <br class="br-mobile">e excelência<br><span class="accent">se encontram</span></h2>
    <div class="video-frame reveal d1">
      <Video src="https://media.dmove.com.br/clients/casa-rofer/videos/sobre-casa-rofer.webm" poster="https://media.dmove.com.br/clients/casa-rofer/photos/hero-casamento.webp" title="Casa Rofer — Espaço de eventos e casamentos" description="Conheça a Casa Rofer, um espaço sofisticado para casamentos e eventos no Brooklin, São Paulo." uploadDate="2026-01-01" duration="PT2M" />
    </div>
  </div>
</section>

<!-- ===== ESPAÇOS ===== -->
<section id="espacos" class="pad" style="background:var(--bg-soft)">
  <div class="wrap">
    <div class="center" style="max-width:1100px;margin-inline:auto">
      <p class="eyebrow reveal">Os Espaços</p>
      <h2 class="section-title center reveal d1" style="max-width:40ch"><span class="accent">Dois cenários exclusivos</span><br>para celebrar <br class="br-mobile">grandes histórias<br>com elegância</h2>
    </div>

    <div class="spaces-stack" style="margin-top:70px">
      <div class="space-card reveal">
        <div class="space-figure m-carousel" id="michelangelo-carousel">
          <button class="m-carousel-btn prev" aria-label="Anterior" type="button">‹</button>
          <div class="m-carousel-track">
            <div class="m-slide active"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao-michelangelo01_v2_resultado.webp" alt="Salão Michelângelo — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao-michelangelo02_v2_resultado.webp" alt="Salão Michelângelo — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao-michelangelo03_v2_resultado.webp" alt="Salão Michelângelo — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao-michelangelo04_v2_resultado.webp" alt="Salão Michelângelo — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao-michelangelo05_v2_resultado.webp" alt="Salão Michelângelo — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao-michelangelo06_v2_resultado.webp" alt="Salão Michelângelo — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao-michelangelo07_v2_resultado.webp" alt="Salão Michelângelo — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao-michelangelo08_v2_resultado.webp" alt="Salão Michelângelo — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao-michelangelo09_v2_resultado.webp" alt="Salão Michelângelo — Casa Rofer" /></div>
          </div>
          <button class="m-carousel-btn next" aria-label="Próximo" type="button">›</button>
          <div class="m-carousel-counter">01 / 09</div>
        </div>
        <div class="space-body">
          <p class="space-tag">Salão 01</p>
          <h3>Salão <span class="accent">Michelângelo</span></h3>
          <p class="lead">Um ambiente sofisticado que combina arquitetura contemporânea, conforto e versatilidade para receber celebrações memoráveis com personalidade e exclusividade.</p>
          <a class="btn ghost" href="#contato">Agende uma visita</a>
        </div>
      </div>
      <div class="space-card rev reveal d1">
        <div class="space-figure m-carousel" id="davinci-carousel">
          <button class="m-carousel-btn prev" aria-label="Anterior" type="button">‹</button>
          <div class="m-carousel-track">
            <div class="m-slide active"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao_da-vinci-v2_09_resultado.webp" alt="Salão Leonardo da Vinci — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao_da-vinci-v2_07_resultado.webp" alt="Salão Leonardo da Vinci — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao_da-vinci-v2_05_resultado.webp" alt="Salão Leonardo da Vinci — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao_da-vinci-v2_04_resultado.webp" alt="Salão Leonardo da Vinci — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao_da-vinci-v2_03_resultado.webp" alt="Salão Leonardo da Vinci — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao_da-vinci-v2_01_resultado.webp" alt="Salão Leonardo da Vinci — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao_da-vinci-v2_08_resultado.webp" alt="Salão Leonardo da Vinci — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao_da-vinci-v2_06_resultado.webp" alt="Salão Leonardo da Vinci — Casa Rofer" /></div>
            <div class="m-slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao_da-vinci-v2_02_resultado.webp" alt="Salão Leonardo da Vinci — Casa Rofer" /></div>
          </div>
          <button class="m-carousel-btn next" aria-label="Próximo" type="button">›</button>
          <div class="m-carousel-counter">01 / 09</div>
        </div>
        <div class="space-body">
          <p class="space-tag">Salão 02</p>
          <h3>Salão <span class="accent">Leonardo da Vinci</span></h3>
          <p class="lead">Cercado por luz natural e integrado a um jardim sofisticado, esse espaço proporciona uma atmosfera única, elegante e acolhedora para cerimônias e recepções inesquecíveis.</p>
          <a class="btn ghost" href="#contato">Agende uma visita</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== EXPERIÊNCIA ===== -->
<section id="experiencia" class="pad">
  <div class="wrap">
    <div class="center" style="max-width:820px;margin-inline:auto">
      <p class="eyebrow reveal">A Experiência</p>
      <h2 class="section-title center reveal d1" style="max-width:33ch">Uma solução completa<br>apenas para que <br class="br-mobile">vocês vivam<br><span class="accent">o melhor do grande dia</span></h2>
      <p class="lead center reveal d2" style="margin-top:24px">Espaços, gastronomia, decoração, tecnologia e atendimento especializado integrados em um único lugar para que cada etapa da celebração aconteça com leveza, sofisticação e total tranquilidade.</p>
    </div>

    <div class="band" style="margin-top:70px">
      <div class="band-media reveal"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/atendimento-consultivo.webp" alt="Atendimento consultivo na Casa Rofer" /></div>
      <div class="band-text">
        <p class="space-tag reveal">Atendimento consultivo</p>
        <h3 class="reveal d1" style="font-size:clamp(1.4rem,2.6vw,2rem);color:var(--title);margin-bottom:16px">Um planejamento feito para <span class="accent">vocês</span></h3>
        <p class="lead reveal d2">Cada casamento recebe um planejamento personalizado, conduzido por uma equipe especializada que acompanha cada decisão com atenção, organização e cuidado, proporcionando segurança e tranquilidade durante toda a jornada.</p>
      </div>
    </div>

    <div class="band rev" style="margin-top:clamp(48px,7vw,90px)">
      <div class="band-media reveal"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/cerimonia-recepcao.webp" alt="Cerimônia e recepção no mesmo endereço" /></div>
      <div class="band-text">
        <p class="space-tag reveal">Cerimônia e recepção no mesmo endereço</p>
        <h3 class="reveal d1" style="font-size:clamp(1.4rem,2.6vw,2rem);color:var(--title);margin-bottom:16px">Do <span class="accent">primeiro voto</span> ao último brinde</h3>
        <p class="lead reveal d2">Da cerimônia ao último brinde, cada momento acontece de forma fluida em um único espaço. Mais conforto para os convidados, menos deslocamentos e uma experiência elegante do início ao fim.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== DIFERENCIAIS ===== -->
<section id="diferenciais" class="pad" style="background:var(--bg-soft)">
  <div class="wrap center">
    <p class="eyebrow reveal">Diferenciais</p>
    <h2 class="section-title center reveal d1" style="max-width:30ch">Excelência em <br class="br-mobile">cada detalhe da<br><span class="accent">sua celebração</span></h2>
  </div>
  <div class="wrap" style="max-width:1600px">
    <div class="dif-grid reveal">
      <div class="dif-card"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/solucao-360.webp" alt="Solução 360º" /><span>Solução 360º</span></div>
      <div class="dif-card"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia.webp" alt="Gastronomia" class="dc-gastronomia" /><span>Gastronomia</span></div>
      <div class="dif-card"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/doces-finos_resultado.webp" alt="Doces finos" /><span>Doces finos</span></div>
      <div class="dif-card"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/coquetelaria_resultado.webp" alt="Coquetelaria" class="dc-coquetelaria" /><span>Coquetelaria</span></div>
      <div class="dif-card"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/decoracao.webp" alt="Decoração" /><span>Decoração</span></div>
      <div class="dif-card"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/tecnologia.webp" alt="Tecnologia" class="dc-tecnologia" /><span>Tecnologia</span></div>
    </div>
  </div>
</section>

<!-- ===== GASTRONOMIA ===== -->
<section id="gastronomia" class="pad">
  <div class="wrap">
    <div class="center" style="max-width:900px;margin-inline:auto">
      <p class="eyebrow reveal">Buffet Rofer</p>
      <h2 class="section-title center reveal d1 section-title-gastronomia" style="max-width:40ch;margin-bottom:26px"><span class="accent">Alta gastronomia</span><br>que transforma cada <br class="br-mobile">celebração <br class="br-desktop">em uma <br class="br-mobile">experiência memorável.</h2>
      <p class="lead center reveal d2">À frente da Gastronomia Rofer estão Ronaldo Akamine, chef executivo e sócio fundador, e João Akamine, chef e gestor, que unem mais de 30 anos de tradição, técnica e inovação para criar menus exclusivos, preparados para surpreender em cada detalhe.</p>
    </div>
  </div>
  <div class="wrap" style="margin-top:52px">
    <div class="carousel reveal">
      <button class="car-btn prev" aria-label="Anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 18l-6-6 6-6"/></svg></button>
      <div class="car-track portrait">
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia_casamentos12_resultado.webp" alt="Gastronomia Rofer" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia_casamentos11_resultado.webp" alt="Gastronomia Rofer" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia_casamentos10_resultado.webp" alt="Gastronomia Rofer" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia_casamentos09_resultado.webp" alt="Gastronomia Rofer" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia_casamentos08_resultado.webp" alt="Gastronomia Rofer" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia_casamentos07_resultado.webp" alt="Gastronomia Rofer" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia_casamentos06_resultado.webp" alt="Gastronomia Rofer" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia_casamentos05_resultado.webp" alt="Gastronomia Rofer" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia_casamentos04_resultado.webp" alt="Gastronomia Rofer" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia_casamentos03_resultado.webp" alt="Gastronomia Rofer" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia_casamentos02_resultado.webp" alt="Gastronomia Rofer" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia_casamentos01_resultado.webp" alt="Gastronomia Rofer" /></div>
      </div>
      <button class="car-btn next" aria-label="Próximo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18l6-6-6-6"/></svg></button>
    </div>
  </div>
</section>

<!-- ===== DEPOIMENTOS ===== -->
<section class="feedbacks pad">
  <div class="fb-bg" data-parallax="0.18"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento03.webp" alt="Celebração na Casa Rofer" /></div>
  <div class="wrap fb-inner">
    <p class="eyebrow center reveal" style="color:var(--sand)">Depoimentos</p>
    <h2 class="section-title center reveal d1" style="color:#fff;margin-inline:auto;max-width:30ch">Quem celebra na Casa&nbsp;Rofer<br><span class="accent">leva boas lembranças</span><br>para toda a vida</h2>
    <div class="stars reveal d1" style="margin-top:26px">★★★★★</div>
    <p class="fb-text reveal d2">Histórias reais de quem viveu momentos inesquecíveis conosco.</p>
    
    <div class="fb-carousel-container reveal d2" style="margin-top:50px">
      <div class="carousel fb-carousel" id="feedback-carousel">
        <button class="car-btn prev" aria-label="Anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 18l-6-6 6-6"/></svg></button>
        <div class="car-track fb-track">
          <div class="fb-card slide">
            <div class="fb-card-stars">★★★★★</div>
            <p class="fb-card-quote">"Realizamos nosso casamento na Casa Rofer e foi simplesmente impecável! A gastronomia superou todas as expectativas, com pratos servidos quentinhos e muito bem apresentados. Todos os convidados elogiaram a fartura e o atendimento dos garçons."</p>
            <div class="fb-card-author">
              <strong>Mariana S.</strong>
              <span>Noiva</span>
            </div>
          </div>
          
          <div class="fb-card slide">
            <div class="fb-card-stars">★★★★★</div>
            <p class="fb-card-quote">"O espaço é maravilhoso! A estrutura do salão nos permitiu criar o ambiente exatamente do jeito que sonhávamos. Desde a cerimônia até o final da festa, o local surpreendeu a todos pela elegância, conforto e excelente infraestrutura."</p>
            <div class="fb-card-author">
              <strong>Rodrigo M.</strong>
              <span>Noivo</span>
            </div>
          </div>
          
          <div class="fb-card slide">
            <div class="fb-card-stars">★★★★★</div>
            <p class="fb-card-quote">"A equipe é extremamente atenciosa e dedicada. Do primeiro contato até o encerramento do evento, nos sentimos muito acolhidos e tranquilos. Eles cuidaram de cada detalhe com carinho para que o nosso grande dia fosse inesquecível."</p>
            <div class="fb-card-author">
              <strong>Camila T.</strong>
              <span>Noiva</span>
            </div>
          </div>
          
          <div class="fb-card slide">
            <div class="fb-card-stars">★★★★★</div>
            <p class="fb-card-quote">"Casar na Casa Rofer foi a nossa melhor escolha. A localização é ótima para os convidados e a sofisticação do ambiente impressionou a todos. Foi uma comemoração incrível que vai ficar guardada para sempre na memória da nossa família."</p>
            <div class="fb-card-author">
              <strong>Felipe A.</strong>
              <span>Noivo</span>
            </div>
          </div>
          
          <div class="fb-card slide">
            <div class="fb-card-stars">★★★★★</div>
            <p class="fb-card-quote">"Amamos a flexibilidade para organizar o layout da festa do nosso jeito. O cuidado da equipe gastronômica fez total diferença: a comida estava divina e o serviço fluiu perfeitamente do começo ao fim. Recomendo de olhos fechados!"</p>
            <div class="fb-card-author">
              <strong>Beatriz L.</strong>
              <span>Noiva</span>
            </div>
          </div>
          
          <div class="fb-card slide">
            <div class="fb-card-stars">★★★★★</div>
            <p class="fb-card-quote">"Só temos a agradecer a toda a equipe da Casa Rofer. O nosso casamento foi um sucesso absoluto e superou nossas expectativas in termos de organização, sabor do buffet e beleza do espaço. Tudo perfeito!"</p>
            <div class="fb-card-author">
              <strong>Lucas R.</strong>
              <span>Noivo</span>
            </div>
          </div>
        </div>
        <button class="car-btn next" aria-label="Próximo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18l6-6-6-6"/></svg></button>
      </div>
    </div>
  </div>
</section>

<!-- ===== GALERIA ===== -->
<section id="galeria" class="pad">
  <div class="wrap center">
    <p class="eyebrow reveal">Galeria</p>
    <h2 class="section-title center reveal d1"><span class="accent">Inspire-se</span> em celebrações<br>que unem sofisticação,<br>beleza e emoção</h2>
  </div>
  <div class="wrap">
    <div class="gal reveal" id="gal">
      <div class="figure g1"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_v2_casamento02_resultado.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g2"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_v2_casamento03_resultado.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g3"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_v2_casamento04_resultado.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g4"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_v2_casamento05_resultado.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g5"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_v2_casamento01_resultado.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g6"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_v2_casamento06_resultado.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g7"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_v2_casamento07_resultado.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g8"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_v2_casamento09_resultado.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g9"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_v2_casamento08_resultado.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g10"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_v2_casamento11_resultado.webp" alt="Celebração na Casa Rofer" /></div>
