---
// Gerado a partir de: index.html
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import Video from '../components/ui/Video.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import WhatsAppWidget from '../components/ui/WhatsAppWidget.astro';
import '../styles/index.css';
---

<Base
  title="Casa Rofer — Espaço de eventos e casamentos | Brooklin, São Paulo"
  description="Mais do que um casamento, uma celebração impecável em cada detalhe. Dois salões exclusivos para até 400 convidados no coração do Brooklin, São Paulo."
  ogImage="/images/og-index.jpg"
>
<!-- ===== HERO ===== -->
<header class="hero" id="top">
  <div class="hero-bg" data-parallax="0.25"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/hero-casamento.webp" alt="Celebração na Casa Rofer, Brooklin — São Paulo" priority /></div>
  <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/logo-white.webp" alt="Casa Rofer" class="hero-logo" />
  <div class="hero-inner">
    <p class="hero-sub reveal in">Brooklin&nbsp; · &nbsp;São Paulo</p>
    <div class="hero-divider reveal in d1"></div>
    <h1 class="reveal in d2">Mais do que <span class="accent">um casamento</span>,<br>uma celebração impecável<br>em&nbsp;cada&nbsp;detalhe</h1>
    <div class="hero-cta reveal in d3">
      <a href="https://api.whatsapp.com/send/?phone=5511941874576&text=Ol%C3%A1!%20Gostaria%20de%20solicitar%20um%20or%C3%A7amento%20para%20meu%20evento%20na%20Casa%20Rofer." class="btn outline" target="_blank" rel="noopener">Solicite orçamento</a>
    </div>
  </div>
  <div class="scroll-ind"><span>Explore</span><span class="line"></span></div>
</header>

<!-- ===== AUTORIDADE ===== -->
<section class="authority">
  <div class="wrap">
    <div class="stat reveal"><b>2 espaços exclusivos</b></div>
    <div class="sep"></div>
    <div class="stat reveal d1"><b>Até 400 convidados</b></div>
    <div class="sep"></div>
    <div class="stat reveal d2"><b>Localização estratégica</b></div>
  </div>
</section>

<!-- ===== SOBRE ===== -->
<section id="sobre" class="pad">
  <div class="wrap center">
    <p class="eyebrow reveal">A Casa Rofer</p>
    <h2 class="section-title center reveal d1" style="max-width:33ch">Um espaço onde arquitetura,<br>hospitalidade e excelência<br><span class="accent">se encontram</span></h2>
    <div class="video-frame reveal d1">
      <Video src="https://media.dmove.com.br/clients/casa-rofer/videos/video-sobre-casamentos.webm" poster="https://media.dmove.com.br/clients/casa-rofer/photos/hero-casamento.webp" title="Casa Rofer — Espaço de eventos e casamentos" description="Conheça a Casa Rofer, um espaço sofisticado para casamentos e eventos no Brooklin, São Paulo." uploadDate="2026-01-01" duration="PT2M" />
    </div>
  </div>
</section>

<!-- ===== ESPAÇOS ===== -->
<section id="espacos" class="pad" style="background:var(--bg-soft)">
  <div class="wrap">
    <div class="center" style="max-width:1100px;margin-inline:auto">
      <p class="eyebrow reveal">Os Espaços</p>
      <h2 class="section-title center reveal d1" style="max-width:40ch"><span class="accent">Dois cenários exclusivos</span><br>para celebrar grandes histórias<br>com elegância</h2>
    </div>

    <div class="spaces-stack" style="margin-top:70px">
      <div class="space-card reveal">
        <div class="space-figure"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao_michelangelo.webp" alt="Salão Michelângelo — Casa Rofer" /></div>
        <div class="space-body">
          <p class="space-tag">Salão 01</p>
          <h3>Salão <span class="accent">Michelângelo</span></h3>
          <p class="lead">Um ambiente sofisticado que combina arquitetura contemporânea, conforto e versatilidade para receber celebrações memoráveis com personalidade e exclusividade.</p>
          <a class="btn ghost" href="https://api.whatsapp.com/send/?phone=5511941874576&text=Ol%C3%A1!%20Gostaria%20de%20agendar%20uma%20visita%20ao%20Sal%C3%A3o%20Michel%C3%A2ngelo%20da%20Casa%20Rofer." target="_blank" rel="noopener">Agende uma visita</a>
        </div>
      </div>
      <div class="space-card rev reveal d1">
        <div class="space-figure"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao_da_vinci.webp" alt="Salão Leonardo da Vinci — Casa Rofer" /></div>
        <div class="space-body">
          <p class="space-tag">Salão 02</p>
          <h3>Salão <span class="accent">Leonardo da Vinci</span></h3>
          <p class="lead">Cercado por luz natural e integrado a um jardim sofisticado, esse espaço proporciona uma atmosfera única, elegante e acolhedora para cerimônias e recepções inesquecíveis.</p>
          <a class="btn ghost" href="https://api.whatsapp.com/send/?phone=5511941874576&text=Ol%C3%A1!%20Gostaria%20de%20agendar%20uma%20visita%20ao%20Sal%C3%A3o%20Leonardo%20da%20Vinci%20da%20Casa%20Rofer." target="_blank" rel="noopener">Agende uma visita</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== EXPERIÊNCIA ===== -->
<section id="experiencia" class="pad">
  <div class="wrap">
    <div class="center" style="max-width:820px;margin-inline:auto">
      <p class="eyebrow reveal">A Experiência</p>
      <h2 class="section-title center reveal d1" style="max-width:33ch">Uma solução completa<br>apenas para que vocês vivam<br><span class="accent">o melhor do grande dia</span></h2>
      <p class="lead center reveal d2" style="margin-top:24px">Espaços, gastronomia, decoração, tecnologia e atendimento especializado integrados em um único lugar para que cada etapa da celebração aconteça com leveza, sofisticação e total tranquilidade.</p>
    </div>

    <div class="band" style="margin-top:70px">
      <div class="band-media reveal"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/atendimento-consultivo.webp" alt="Atendimento consultivo na Casa Rofer" /></div>
      <div class="band-text">
        <p class="space-tag reveal">Atendimento consultivo</p>
        <h3 class="reveal d1" style="font-size:clamp(1.4rem,2.6vw,2rem);color:var(--title);margin-bottom:16px">Um planejamento feito para <span class="accent">vocês</span></h3>
        <p class="lead reveal d2">Cada casamento recebe um planejamento personalizado, conduzido por uma equipe especializada que acompanha cada decisão com atenção, organização e cuidado, proporcionando segurança e tranquilidade durante toda a jornada.</p>
      </div>
    </div>

    <div class="band rev" style="margin-top:clamp(48px,7vw,90px)">
      <div class="band-media reveal"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/cerimonia-recepcao.webp" alt="Cerimônia e recepção no mesmo endereço" /></div>
      <div class="band-text">
        <p class="space-tag reveal">Cerimônia e recepção no mesmo endereço</p>
        <h3 class="reveal d1" style="font-size:clamp(1.4rem,2.6vw,2rem);color:var(--title);margin-bottom:16px">Do <span class="accent">primeiro voto</span> ao último brinde</h3>
        <p class="lead reveal d2">Da cerimônia ao último brinde, cada momento acontece de forma fluida em um único espaço. Mais conforto para os convidados, menos deslocamentos e uma experiência elegante do início ao fim.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== DIFERENCIAIS ===== -->
<section id="diferenciais" class="pad" style="background:var(--bg-soft)">
  <div class="wrap center">
    <p class="eyebrow reveal">Diferenciais</p>
    <h2 class="section-title center reveal d1" style="max-width:30ch">Excelência em cada detalhe da<br><span class="accent">sua celebração</span></h2>
  </div>
  <div class="wrap">
    <div class="dif-grid reveal">
      <div class="dif-card"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/solucao-360.webp" alt="Solução 360º" /><span>Solução 360º</span></div>
      <div class="dif-card"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia.webp" alt="Gastronomia" class="dc-gastronomia" /><span>Gastronomia</span></div>
      <div class="dif-card"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/decoracao.webp" alt="Decoração" /><span>Decoração</span></div>
      <div class="dif-card"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/tecnologia.webp" alt="Tecnologia" class="dc-tecnologia" /><span>Tecnologia</span></div>
    </div>
  </div>
</section>

<!-- ===== GASTRONOMIA ===== -->
<section id="gastronomia" class="pad">
  <div class="wrap">
    <div class="center" style="max-width:900px;margin-inline:auto">
      <p class="eyebrow reveal">Buffet Rofer</p>
      <h2 class="section-title center reveal d1" style="max-width:40ch;margin-bottom:26px"><span class="accent">Alta gastronomia</span><br>que transforma cada celebração<br>em uma experiência memorável.</h2>
      <p class="lead center reveal d2">À frente da Gastronomia Rofer estão Ronaldo Akamine, chef executivo e sócio fundador, e João Akamine, chef e gestor, que unem mais de 30 anos de tradição, técnica e inovação para criar menus exclusivos, preparados para surpreender em cada detalhe.</p>
    </div>
  </div>
  <div class="wrap" style="margin-top:52px">
    <div class="carousel reveal">
      <button class="car-btn prev" aria-label="Anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 18l-6-6 6-6"/></svg></button>
      <div class="car-track land">
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/carrossel_gastronomia01.webp" alt="Gastronomia Rofer" class="gp-70" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/carrossel_gastronomia02.webp" alt="Gastronomia Rofer" class="gp-70" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/carrossel_gastronomia03.webp" alt="Gastronomia Rofer" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/carrossel_gastronomia04.webp" alt="Gastronomia Rofer" class="gp-40" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/carrossel_gastronomia05.webp" alt="Gastronomia Rofer" class="gp-55" /></div>
        <div class="slide"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/carrossel_gastronomia06.webp" alt="Gastronomia Rofer" class="gp-55" /></div>
      </div>
      <button class="car-btn next" aria-label="Próximo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18l6-6-6-6"/></svg></button>
    </div>
  </div>
</section>

<!-- ===== DEPOIMENTOS ===== -->
<section class="feedbacks pad">
  <div class="fb-bg" data-parallax="0.18"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento03.webp" alt="Celebração na Casa Rofer" /></div>
  <div class="wrap fb-inner">
    <p class="eyebrow center reveal" style="color:var(--sand)">Depoimentos</p>
    <h2 class="section-title center reveal d1" style="color:#fff;margin-inline:auto;max-width:30ch">Quem celebra na Casa&nbsp;Rofer<br><span class="accent">leva boas lembranças</span><br>para toda a vida</h2>
    <div class="stars reveal d1" style="margin-top:26px">★★★★★</div>
    <p class="fb-text reveal d2">Histórias reais de quem viveu momentos inesquecíveis conosco.<br>Leia as avaliações dos nossos clientes diretamente no Google.</p>
    <div class="fb-cta reveal d2">
      <a href="https://www.google.com/search?q=casa+rofer#lrd=0x94ce51a904bb89f3:0x9f1f75bc754a0175,1" target="_blank" rel="noopener">★ Ver avaliações no Google</a>
    </div>
  </div>
</section>

<!-- ===== GALERIA ===== -->
<section id="galeria" class="pad">
  <div class="wrap center">
    <p class="eyebrow reveal">Galeria</p>
    <h2 class="section-title center reveal d1"><span class="accent">Inspire-se</span> em celebrações<br>que unem sofisticação,<br>beleza e emoção</h2>
  </div>
  <div class="wrap">
    <div class="gal reveal" id="gal">
      <div class="figure g1"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento01.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g2"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento02.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g3"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento03.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g4"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento04.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g5"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento05.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g6"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento06.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g7"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento07.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g8"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento08.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g9"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento09.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g10"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento10.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g11"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento11.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g12"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento12.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g13"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento13.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g14"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento14.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g15"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento15.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g16"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento16.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g17"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento17.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g18"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento18.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g19"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento19.webp" alt="Celebração na Casa Rofer" /></div>
      <div class="figure g20"><Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_casamento20.webp" alt="Celebração na Casa Rofer" /></div>
    </div>
  </div>
</section>

<!-- ===== CONTATO ===== -->
<section id="contato" class="form-sec pad">
  <div class="wrap form-card">
    <div class="center">
      <p class="eyebrow reveal">Contato</p>
      <h2 class="section-title center reveal d1" style="max-width:40ch">Vamos criar uma <br>celebração única para <br><span class="accent">a sua história</span>?</h2>
      <p class="lead center reveal d2" style="margin-top:20px">Preencha o formulário e receba um atendimento personalizado para conhecer nosso espaço, esclarecer dúvidas e solicitar um orçamento.</p>
    </div>
    <LeadForm
      formId="lead-form"
      project={config.project_slug}
      submitUrl={config.forms['lead-form'].webhooks[0]}
      redirectUrl={config.forms['lead-form'].redirect_on_success}
      submitText="Solicitar Orçamento"
      honeypot
      fields={[
        { type: 'row', fields: [
          { name: 'nome',       type: 'text',   label: 'Nome',     required: true },
          { name: 'telefone',   type: 'text',   label: 'Telefone', required: true },
        ]},
        { name: 'email', type: 'email', label: 'E-mail', required: true },
        { type: 'row', fields: [
          { name: 'data_evento', type: 'text',   label: 'Data do evento', placeholder: 'dd/mm/aaaa' },
          { name: 'convidados', type: 'number', label: 'Número de convidados' },
        ]},
        { name: 'tipo_evento', type: 'select', label: 'Tipo de evento', options: [
          { value: '',                        label: 'Selecione o tipo de evento', disabled: true, selected: true },
          { value: 'Bodas',                   label: 'Bodas' },
          { value: 'Casamentos',              label: 'Casamentos' },
          { value: 'Confraternizacao social', label: 'Confraternização social' },
          { value: 'Outros',                  label: 'Outros' },
        ]},
      ]}
    />
    <div class="form-success" id="formSuccess">
      <p class="serif">Recebemos <span class="accent">sua solicitação</span> ✦</p>
      <p class="lead center">Obrigado pelo contato. Em breve nossa equipe retornará para começar a planejar a sua celebração na Casa Rofer.</p>
    </div>
  </div>
</section>

<!-- ===== LOCALIZAÇÃO ===== -->
<section id="localizacao" class="pad">
  <div class="wrap">
    <div class="center" style="max-width:760px;margin-inline:auto">
      <p class="eyebrow reveal">Localização</p>
      <h2 class="section-title center reveal d1"><span class="accent">Um endereço privilegiado</span> para celebrar momentos extraordinários</h2>
    </div>
    <div class="loc-grid">
      <div class="loc-info reveal">
        <p class="addr">R. Baltazar Fernandes, 54<br>Brooklin, São Paulo — SP<br>04583-020</p>
        <a class="btn ghost" href="https://www.google.com/maps/search/?api=1&query=R.+Baltazar+Fernandes,+54+-+Brooklin,+São+Paulo+-+SP,+04583-020" target="_blank" rel="noopener">Ver no mapa</a>
      </div>
      <div class="loc-map reveal d1">
        <iframe title="Mapa Casa Rofer" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=R.%20Baltazar%20Fernandes,%2054%20-%20Brooklin,%20S%C3%A3o%20Paulo%20-%20SP,%2004583-020&output=embed"></iframe>
      </div>
    </div>
  </div>
</section>

<!-- ===== FOOTER ===== -->
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/logo-white.webp" alt="Casa Rofer" class="foot-logo" />
        <p>A arte de celebrar com excelência. Espaço de eventos e casamentos no coração do Brooklin, São Paulo.</p>
      </div>
      <div class="foot-col">
        <h4>Localização</h4>
        <span>R. Baltazar Fernandes, 54</span>
        <span>Brooklin — São Paulo, SP</span>
        <span>04583-020</span>
        <a href="https://api.whatsapp.com/send/?phone=5511941874576&text=Ol%C3%A1!%20Gostaria%20de%20agendar%20uma%20visita%20%C3%A0%20Casa%20Rofer." target="_blank" rel="noopener">Agende uma visita</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 Casa Rofer · Brooklin, São Paulo. Todos os direitos reservados.</span>
      <span style="display:inline-flex;align-items:center;gap:8px">Desenvolvido por <a href="https://www.dmove.com.br" target="_blank" rel="noopener" style="display:inline-flex;align-items:center"><img src="https://media.dmove.com.br/clients/casa-rofer/photos/Logotipo-dmove.webp" alt="Dmove" style="height:30px;width:auto;opacity:0.95" /></a></span>
    </div>
  </div>
</footer>

<!-- ===== LIGHTBOX ===== -->
<div class="lb" id="lb">
  <button class="lb-close" id="lbClose" aria-label="Fechar">×</button>
  <button class="lb-nav prev" id="lbPrev" aria-label="Anterior">‹</button>
  <img id="lbImg" src="" alt="" />
  <button class="lb-nav next" id="lbNext" aria-label="Próximo">›</button>
</div>


</Base>

<WhatsAppWidget
  phone={config.whatsapp.phone}
  displayName={config.whatsapp.display_name}
  submitUrl={config.forms['lead-form'].webhooks[0]}
  project={config.project_slug}
/>

<script>
  import '../scripts/index.js';
</script>
