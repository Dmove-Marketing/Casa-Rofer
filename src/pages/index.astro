<!-- ===== CONTATO ===== -->
<section id="contato" class="form-sec pad">
  <div class="wrap form-card">
    <div class="center">
      <p class="eyebrow reveal">Contato</p>
      <h2 class="section-title center reveal d1" style="max-width:40ch">Vamos criar uma <br>celebração única para <br><span class="accent">a sua história</span>?</h2>
      <p class="lead center reveal d2" style="margin-top:20px">Preencha o formulário e receba um atendimento personalizado para conhecer nosso espaço, esclarecer dúvidas e solicitar um orçamento.</p>
    </div>
    <LeadForm
      formId="lead-form"
      project={config.project_slug}
      fonte="Landing page/casamentos"
      submitUrl={config.forms['lead-form'].webhooks[0]}
      redirectUrl={config.forms['lead-form'].redirect_on_success}
      submitText="Solicitar Orçamento"
      honeypot
      fields={[
        { type: 'row', fields: [
          { name: 'nome',       type: 'text',   label: 'Nome',     required: true },
          { name: 'telefone',   type: 'text',   label: 'Telefone', required: true },
        ]},
        { name: 'email', type: 'email', label: 'E-mail', required: true },
        { type: 'row', fields: [
          { name: 'data_evento', type: 'text',   label: 'Data do evento', placeholder: 'dd/mm/aaaa', datepicker: true, required: true },
          { name: 'convidados', type: 'number', label: 'Número de convidados', required: true },
        ]},
        { name: 'tipo_evento', type: 'select', label: 'Tipo de evento', options: [
          { value: '',                        label: 'Selecione o tipo de evento', disabled: true, selected: true },
          { value: 'Aniversario',             label: 'Aniversário' },
          { value: 'Bodas',                   label: 'Bodas' },
          { value: 'Casamentos',              label: 'Casamentos' },
          { value: 'Confraternizacao social', label: 'Confraternização social' },
          { value: 'Debutante',               label: 'Debutante' },
          { value: 'Outros',                  label: 'Outros' },
        ]},
      ]}
    />
    <div class="form-success" id="formSuccess">
      <p class="serif">Recebemos <span class="accent">sua solicitação</span> ✦</p>
      <p class="lead center">Obrigado pelo contato. Em breve nossa equipe retornará para começar a planejar a sua celebração na Casa Rofer.</p>
    </div>
  </div>
</section>

<!-- ===== LOCALIZAÇÃO ===== -->
<section id="localizacao" class="pad">
  <div class="wrap">
    <div class="center" style="max-width:760px;margin-inline:auto">
