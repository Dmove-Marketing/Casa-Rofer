<script>
  function initInfiniteGastroCarousel() {
    const carousel = document.getElementById('gastronomy-carousel');
    if (!carousel) return;
    const track = carousel.querySelector('.gastro-track');
    if (!track || track.querySelector('.clone')) return;
    const prevBtn = carousel.querySelector('.prev');
    const nextBtn = carousel.querySelector('.next');
    const slides = [...track.querySelectorAll('.slide')];
    if (slides.length === 0) return;
    const numVisible = 3;
    const clonesBefore = slides.slice(-numVisible).map(s => s.cloneNode(true));
    const clonesAfter  = slides.slice(0, numVisible).map(s => s.cloneNode(true));
    clonesBefore.forEach(c => { c.classList.add('clone'); track.insertBefore(c, track.firstChild); });
    clonesAfter.forEach(c  => { c.classList.add('clone'); track.appendChild(c); });
    let currentIndex = numVisible;
    function getStep() {
      const s = track.querySelector('.slide');
      const gap = parseFloat(window.getComputedStyle(track).gap) || 16;
      return s ? s.offsetWidth + gap : 0;
    }
    function scrollTo(index, smooth = true) {
      currentIndex = index;
      track.scrollTo({ left: getStep() * currentIndex, behavior: smooth ? 'smooth' : 'auto' });
    }
    setTimeout(() => scrollTo(numVisible, false), 100);
    let adj = false;
    track.addEventListener('scroll', () => {
      if (adj) return;
      const step = getStep();
      if (!step) return;
      const total = track.querySelectorAll('.slide').length;
      const cur = Math.round(track.scrollLeft / step);
      if (cur >= total - numVisible) {
        adj = true; currentIndex = numVisible;
        track.scrollTo({ left: step * currentIndex, behavior: 'auto' });
        setTimeout(() => { adj = false; }, 60);
      } else if (cur <= 0) {
        adj = true; currentIndex = total - numVisible * 2;
        track.scrollTo({ left: step * currentIndex, behavior: 'auto' });
        setTimeout(() => { adj = false; }, 60);
      }
    });
    function next() { const s = getStep(); if (!s) return; scrollTo(Math.round(track.scrollLeft / s) + 1); }
    function prev() { const s = getStep(); if (!s) return; scrollTo(Math.round(track.scrollLeft / s) - 1); }
    let timer = null;
    function start() { stop(); timer = setInterval(next, 3500); }
    function stop()  { if (timer) clearInterval(timer); }
    start();
    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    carousel.addEventListener('touchstart', stop, { passive: true });
    nextBtn?.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); next(); start(); });
    prevBtn?.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); prev(); start(); });
  }

  function initGalleryCarousel() {
    const wrapper = document.querySelector('.gal-carousel-wrapper');
    if (!wrapper) return;
    const track   = wrapper.querySelector('#gal');
    const prevBtn = wrapper.querySelector('.gal-car-btn.prev');
    const nextBtn = wrapper.querySelector('.gal-car-btn.next');
    if (!track || !prevBtn || !nextBtn) return;
    const step = () => { const f = track.querySelector('.figure'); return f ? f.offsetWidth + 16 : track.clientWidth * 0.8; };
    prevBtn.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    nextBtn.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); track.scrollBy({ left:  step(), behavior: 'smooth' }); });
  }

  document.addEventListener('DOMContentLoaded', () => { initInfiniteGastroCarousel(); initGalleryCarousel(); });
  initInfiniteGastroCarousel();
  initGalleryCarousel();
</script>

<script>
  (function () {
    var p = document.querySelector('.dpain');
    if (!p) return;
    var itens = [].slice.call(p.querySelectorAll('.dpain__item'));
    function ativar(el) {
      itens.forEach(function (i) {
        var a = i === el;
        i.classList.toggle('is-ativo', a);
        i.setAttribute('aria-pressed', a ? 'true' : 'false');
      });
    }
    var hover = window.matchMedia('(hover: hover) and (min-width: 769px)');
    itens.forEach(function (i) {
      i.addEventListener('click',      function () { ativar(i); });
      i.addEventListener('focus',      function () { ativar(i); });
      i.addEventListener('mouseenter', function () { if (hover.matches) ativar(i); });
    });
  })();
</script>

