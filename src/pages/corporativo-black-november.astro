<script>
  import '../scripts/black-november.js';

  /* Seção Experiência: ícones se desenham (anel, traço e nome) ao entrar na tela, uma vez */
  (function () {
    var lista = document.querySelector('.experiencia__lista');
    if (!lista || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    lista.classList.add('anima-experiencia');
    var obs = new IntersectionObserver(function (entradas) {
      if (!entradas[0].isIntersecting) return;
      lista.classList.add('is-desenhada');
      obs.disconnect();
    }, { threshold: 0.2 });
    obs.observe(lista);
  })();
</script>
