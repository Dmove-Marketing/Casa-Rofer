---
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import Video from '../components/ui/Video.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import '../styles/black-november.css';
---

<Base
  title="Black November Casa Rofer | Condições especiais para eventos corporativos em 2027"
  description="Black November Casa Rofer: de 01 a 30 de novembro, datas de 2027 com condições especiais e cortesias para eventos corporativos no Brooklin, São Paulo."
  ogImage="https://media.dmove.com.br/clients/casa-rofer/photos/hero-lounge-com-telao-casa-rofer.webp"
  canonical="https://eventos.casarofer.com.br/corporativo-black-november/"
>
<main>

 <!-- HERO -->
 <section class="hero hero--titulo" id="topo">
 <div class="hero__imagem">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/hero-lounge-com-telao-casa-rofer.webp" alt="Lounge da Casa Rofer montado para evento corporativo, com sofás, jardim vertical e telão com a marca Rofer" width={1536} height={1024} priority />
 </div>
 <div class="hero__conteudo">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/logo-casa-rofer-areia.webp" alt="Casa Rofer" width={640} height={228} class="hero__logo" />
 <h1 class="hero__titulo">
 <span class="hero__titulo-linha">Black</span>
 <span class="hero__titulo-linha hero__titulo-linha--menor">November</span>
 <span class="visualmente-oculto">Casa Rofer</span>
 </h1>
 <p class="hero__periodo">De 01 a 30 de novembro</p>
 <p class="hero__publico">Datas selecionadas com condições especiais para realizar seu evento corporativo em um espaço à&nbsp;altura da sua marca em&nbsp;2027.</p>
 <a class="botao botao--claro hero__cta" href="#contato">Fale com nossa equipe</a>
 </div>
 </section>

 <!-- CONHEÇA A CASA ROFER — texto + vídeo -->
 <section class="conheca" id="conheca" aria-labelledby="conheca-titulo">
 <div class="container conheca__grade">
 <div class="conheca__texto-bloco">
 <h2 class="conheca__titulo" id="conheca-titulo">Conheça a Casa Rofer</h2>
 <p class="conheca__texto conheca__texto--quebras">No coração do Brooklin, a Casa Rofer reúne<br class="br-desktop"> arquitetura marcante, tecnologia e sofisticação<br class="br-desktop"> para eventos corporativos que pedem excelência.<br class="br-desktop"> Dois ambientes integrados, até 250&nbsp;convidados e<br class="br-desktop"> uma solução 360°, com estrutura, gastronomia<br class="br-desktop"> e operação em um só&nbsp;lugar.</p>
 </div>
 <div class="conheca__video">
 <Video src={new URL('/videos/conheca-casa-rofer.mp4', Astro.url).href} poster={new URL('/videos/conheca-casa-rofer-capa.webp', Astro.url).href} title="Conheça a Casa Rofer" description="Conheça a Casa Rofer, espaço sofisticado para eventos corporativos e celebrações no Brooklin, São Paulo." uploadDate="2026-10-07" duration="PT1M48S" autoplay />
 </div>
 </div>
 </section>

 <!-- GALERIA — mosaico; clique amplia a foto -->
 <section class="galeria" id="galeria" aria-labelledby="galeria-titulo">
 <div class="container">
 <div class="galeria__cabecalho">
 <h2 class="galeria__titulo" id="galeria-titulo">Grandes marcas que já<br class="br-desktop"> escolheram a Casa Rofer</h2>
 </div>
 <ul class="mosaico" aria-label="Fotos de eventos corporativos na Casa Rofer">
 <li class="mosaico__foto mosaico__foto--grande">
 <button class="mosaico__botao" type="button" data-legenda="Palestra no auditório" aria-label="Ampliar foto: Palestra no auditório">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-01-palestra-no-auditorio.webp" alt="Palestrante no palco diante de plateia lotada, com telão de LED e iluminação azul" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--alta mosaico__foto--vertical">
 <button class="mosaico__botao" type="button" data-legenda="Palestrante no palco" aria-label="Ampliar foto: Palestrante no palco">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-02-palestrante-no-palco.webp" alt="Palestrante falando ao microfone no palco, diante de painel com texto da apresentação" width={933} height={1400} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--alta mosaico__foto--vertical">
 <button class="mosaico__botao" type="button" data-legenda="Auditório montado" aria-label="Ampliar foto: Auditório montado">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-03-auditorio-montado.webp" alt="Salão montado em formato auditório, com cadeiras de palhinha e telão ao fundo" width={933} height={1400} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--alta">
 <button class="mosaico__botao" type="button" data-legenda="Bartender servindo drinks" aria-label="Ampliar foto: Bartender servindo drinks">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-12-bartender-servindo-drinks.webp" alt="Bartender servindo drinks em bandeja diante do jardim vertical" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--alta mosaico__foto--vertical">
 <button class="mosaico__botao" type="button" data-legenda="Coffee break" aria-label="Ampliar foto: Coffee break">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-13-coffee-break.webp" alt="Mesa de coffee break com salgados, louças e arranjo de flores junto à parede de tijolos" width={933} height={1400} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--larga">
 <button class="mosaico__botao" type="button" data-legenda="Estande de marca" aria-label="Ampliar foto: Estande de marca">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-04-estande-de-marca.webp" alt="Estande de marca com balcões personalizados e equipe recebendo os convidados" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--larga">
 <button class="mosaico__botao" type="button" data-legenda="Lounge iluminado" aria-label="Ampliar foto: Lounge iluminado">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-05-lounge-iluminado.webp" alt="Lounge com sofás de couro, jardim vertical e iluminação azul no salão" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--larga">
 <button class="mosaico__botao" type="button" data-legenda="Plateia e passarela" aria-label="Ampliar foto: Plateia e passarela">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-06-plateia-e-passarela.webp" alt="Plateia acompanhando apresentação em passarela com telão de LED" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--larga">
 <button class="mosaico__botao" type="button" data-legenda="Jantar corporativo" aria-label="Ampliar foto: Jantar corporativo">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-07-jantar-corporativo.webp" alt="Mesa imperial posta para jantar corporativo, com taças, arranjo de flores e telão ao fundo" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--larga">
 <button class="mosaico__botao" type="button" data-legenda="Brindes personalizados" aria-label="Ampliar foto: Brindes personalizados">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-08-brindes-personalizados.webp" alt="Sacolas e mochilas personalizadas com a marca do evento" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--larga">
 <button class="mosaico__botao" type="button" data-legenda="Lounge do salão" aria-label="Ampliar foto: Lounge do salão">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-09-lounge-do-salao.webp" alt="Lounge do salão com poltronas verdes, mesas e jardim vertical" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--larga">
 <button class="mosaico__botao" type="button" data-legenda="Networking" aria-label="Ampliar foto: Networking">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-10-networking.webp" alt="Convidados conversando em pé durante o networking no salão" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--grande">
 <button class="mosaico__botao" type="button" data-legenda="Painel com convidado no telão" aria-label="Ampliar foto: Painel com convidado no telão">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-14-painel-com-convidado-no-telao.webp" alt="Painel com três participantes no palco e um convidado em videochamada no telão" width={1400} height={933} />
 </button>
 </li>
 <li class="mosaico__foto mosaico__foto--larga">
 <button class="mosaico__botao" type="button" data-legenda="Auditório no jardim de inverno" aria-label="Ampliar foto: Auditório no jardim de inverno">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria-11-auditorio-jardim-de-inverno.webp" alt="Auditório montado no jardim de inverno, com cadeiras de palhinha e paredes verdes" width={1400} height={933} />
 </button>
 </li>
 </ul>
 </div>
 </section>

 <div class="ampliada" role="dialog" aria-modal="true" aria-label="Foto ampliada" aria-hidden="true">
 <button class="galeria__botao ampliada__fechar" type="button" aria-label="Fechar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
 <div class="ampliada__palco"><Img src="placeholder.jpg" alt="" /></div>
 </div>

 <!-- SOBRE / CONDIÇÕES -->
 <section class="sobre" id="condicoes">
 <div class="container">
 <span class="rotulo">Black November 2026</span>
 <h2 class="sobre__titulo sobre__titulo--equilibrado">Garanta a data ideal para os eventos da sua&nbsp;empresa</h2>
 <p class="sobre__texto sobre__texto--campanha">A Black November Casa Rofer é a oportunidade para planejar o calendário corporativo de&nbsp;2027 com antecedência. As condições valem para datas selecionadas de&nbsp;2027 e para eventos contratados entre 01 e 30&nbsp;de&nbsp;novembro. A Casa Rofer realiza um evento por dia: quando uma data é reservada, ela deixa de estar&nbsp;disponível.</p>
 <p class="sobre__aviso">Condições vinculadas à contratação durante a campanha e às condições de disponibilidade.</p>
 </div>
 </section>

 <!-- BENEFÍCIO 1 -->
 <section class="beneficio beneficio--areia" id="beneficio-25-off">
 <div class="container beneficio__grade">
 <div class="beneficio__imagem">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/beneficio-25-off-auditorio-com-painel.webp" alt="Auditório lotado assistindo a um painel com palestrantes diante do telão" width={1400} height={933} />
 </div>
 <div class="beneficio__conteudo">
 <span class="rotulo">Condição 01</span>
 <h2 class="beneficio__titulo beneficio__titulo--compacto">Planeje o calendário de eventos de&nbsp;2027</h2>
 <p class="beneficio__texto beneficio__texto--campanha beneficio__texto--longo">Durante novembro, datas selecionadas do próximo ano<br class="br-desktop"> na Casa Rofer contam com condições diferenciadas.<br class="br-desktop"> Convenções, coquetéis, treinamentos e confraternizações<br class="br-desktop"> em dois ambientes para até 250&nbsp;convidados, com tecnologia,<br class="br-desktop"> gastronomia e operação&nbsp;integradas.</p>
 <p class="beneficio__aviso">Condições vinculadas à contratação durante a campanha e às condições de disponibilidade.</p>
 <a class="botao botao--primario beneficio__cta" href="#contato">Fale com nossa equipe</a>
 </div>
 </div>
 </section>

 <!-- BENEFÍCIO 2 -->
 <section class="beneficio beneficio--invertido" id="beneficio-20-off">
 <div class="container beneficio__grade">
 <div class="beneficio__imagem">
 <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/beneficio-20-off-palestra-com-telao.webp" alt="Palestrante apresentando para a plateia ao lado de um telão no salão" width={1400} height={926} />
 </div>
 <div class="beneficio__conteudo">
 <span class="rotulo">Condição 02</span>
 <h2 class="beneficio__titulo beneficio__titulo--compacto">Excelência que sua empresa&nbsp;merece</h2>
 <p class="beneficio__texto beneficio__texto--campanha beneficio__texto--longo">Neste novembro, datas selecionadas de 2027 contam com condições especiais. Um endereço estratégico no Brooklin, 1.300&nbsp;m² de área útil e uma solução 360° para receber sua empresa com&nbsp;excelência.</p>
 <p class="beneficio__aviso">Condições vinculadas à contratação durante a campanha e às condições de disponibilidade.</p>
 <a class="botao botao--primario beneficio__cta" href="#contato">Solicite orçamento</a>
 </div>
 </div>
 </section>

 <!-- CLIENTES — faixa de logos rolando sozinha (cores originais; tamanho visual igualado pela área) -->
 <section class="clientes" id="clientes" aria-labelledby="clientes-titulo">
 <div class="container">
 <span class="rotulo">Clientes</span>
 <h2 class="clientes__titulo" id="clientes-titulo">Empresas que já realizaram eventos na Casa&nbsp;Rofer</h2>
 </div>
 <div class="clientes__faixa">
 <ul class="clientes__trilho">
 <li class="clientes__logo"><img src="/images/clientes/alcon.webp" alt="Alcon" width="143" height="39" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo"><img src="/images/clientes/ibm.webp" alt="IBM" width="123" height="46" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo"><img src="/images/clientes/caixa.webp" alt="Caixa Econômica Federal" width="136" height="41" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo"><img src="/images/clientes/claro.webp" alt="Claro" width="124" height="45" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo"><img src="/images/clientes/nestle.webp" alt="Nestlé" width="146" height="38" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo"><img src="/images/clientes/banco-abc.webp" alt="Banco ABC Brasil" width="58" height="58" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo"><img src="/images/clientes/shark-tank.webp" alt="Shark Tank" width="170" height="33" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo"><img src="/images/clientes/camicado.webp" alt="Camicado" width="160" height="35" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo"><img src="/images/clientes/caras.webp" alt="Caras" width="104" height="54" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo"><img src="/images/clientes/gree.webp" alt="Gree" width="169" height="33" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo"><img src="/images/clientes/inova-food-summit.webp" alt="Inova Food Summit" width="90" height="58" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo"><img src="/images/clientes/johnson-johnson.webp" alt="Johnson & Johnson" width="176" height="32" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo"><img src="/images/clientes/peugeot.webp" alt="Peugeot" width="82" height="58" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo"><img src="/images/clientes/mercer.webp" alt="Mercer" width="141" height="40" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo" aria-hidden="true"><img src="/images/clientes/alcon.webp" alt="" data-alt="Alcon" width="143" height="39" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo" aria-hidden="true"><img src="/images/clientes/ibm.webp" alt="" data-alt="IBM" width="123" height="46" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo" aria-hidden="true"><img src="/images/clientes/caixa.webp" alt="" data-alt="Caixa Econômica Federal" width="136" height="41" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo" aria-hidden="true"><img src="/images/clientes/claro.webp" alt="" data-alt="Claro" width="124" height="45" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo" aria-hidden="true"><img src="/images/clientes/nestle.webp" alt="" data-alt="Nestlé" width="146" height="38" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo" aria-hidden="true"><img src="/images/clientes/banco-abc.webp" alt="" data-alt="Banco ABC Brasil" width="58" height="58" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo" aria-hidden="true"><img src="/images/clientes/shark-tank.webp" alt="" data-alt="Shark Tank" width="170" height="33" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo" aria-hidden="true"><img src="/images/clientes/camicado.webp" alt="" data-alt="Camicado" width="160" height="35" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo" aria-hidden="true"><img src="/images/clientes/caras.webp" alt="" data-alt="Caras" width="104" height="54" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo" aria-hidden="true"><img src="/images/clientes/gree.webp" alt="" data-alt="Gree" width="169" height="33" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo" aria-hidden="true"><img src="/images/clientes/inova-food-summit.webp" alt="" data-alt="Inova Food Summit" width="90" height="58" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo" aria-hidden="true"><img src="/images/clientes/johnson-johnson.webp" alt="" data-alt="Johnson & Johnson" width="176" height="32" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo" aria-hidden="true"><img src="/images/clientes/peugeot.webp" alt="" data-alt="Peugeot" width="82" height="58" loading="lazy" decoding="async" /></li>
 <li class="clientes__logo" aria-hidden="true"><img src="/images/clientes/mercer.webp" alt="" data-alt="Mercer" width="141" height="40" loading="lazy" decoding="async" /></li>
 </ul>
 </div>
 </section>

 <!-- EXPERIÊNCIA — tipos de cortesia em ícones -->
 <section class="experiencia" id="experiencia" aria-labelledby="experiencia-titulo">
 <div class="container">
 <span class="rotulo">Detalhes que encantam</span>
 <h2 class="experiencia__titulo" id="experiencia-titulo">Personalize seu evento</h2>
 <p class="experiencia__texto">Cada evento tem seu propósito, e a experiência também pode ser pensada para ele. Escolha as cortesias que mais combinam com a sua&nbsp;empresa.</p>
 <ul class="experiencia__lista experiencia__lista--quatro">
 <li class="experiencia__item" style="--i:0"><span class="experiencia__icone"><svg class="experiencia__svg" viewBox="-3 -3 102 102" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="exp-anel"><circle class="exp-traco" cx="48" cy="48" r="46" pathLength="1"/><circle class="exp-traco exp-anel-interno" cx="48" cy="48" r="40.5" pathLength="1"/><path class="exp-losango" d="M48 -0.6l2.6 2.6-2.6 2.6-2.6-2.6z"/></g><g class="exp-desenho"><g class="exp-ajuste" transform="translate(48 48) scale(0.832) translate(-48.00 -50.50)" style="--traco: 1.38"><path class="exp-traco" pathLength="1" d="M34 52V40a4 4 0 0 1 4-4h20a4 4 0 0 1 4 4v12"/><path class="exp-traco" pathLength="1" d="M30 47a3 3 0 0 1 3 3v6h30v-6a3 3 0 0 1 6 0v10H27V50a3 3 0 0 1 3-3z"/><path class="exp-traco" pathLength="1" d="M37 52h22"/><path class="exp-traco" pathLength="1" d="M32 60v5"/><path class="exp-traco" pathLength="1" d="M64 60v5"/><path class="exp-traco" pathLength="1" d="M48 36v16"/></g></g></svg></span><span class="experiencia__nome">Decoração</span></li>
