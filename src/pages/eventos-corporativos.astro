  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria-atualizada_corporativos09.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria-atualizada_corporativos08.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria-atualizada_corporativos07.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria_nova_corporativos09_resultado.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria_nova_corporativos08_resultado.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria_nova_corporativos07_resultado.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria_nova_corporativos06_resultado.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria_nova_corporativos05_resultado.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria_nova_corporativos04_resultado.webp',
