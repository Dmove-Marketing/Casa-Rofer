  'https://media.dmove.com.br/clients/casa-rofer/photos/inovafood-logo-1-YrDqgXro7Gu40wen_resultado.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/logo-abc-ocre_resultado.webp',
