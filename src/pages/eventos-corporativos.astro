import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import Video from '../components/ui/Video.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import { tipoEventoOptions } from '../scripts/lead-payload';
import '../styles/eventos-corporativos.css';



const gastronomiaImages = [
  'https://media.dmove.com.br/clients/casa-rofer/photos/carrossel-gastronomia_corporativo06_resultado.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/carrossel-gastronomia_corporativo05_resultado.webp',
