<script>
  function initInfiniteGastroCarousel() {
    const carousel = document.getElementById('gastronomy-carousel');
    if (!carousel) return;

    const track = carousel.querySelector('.gastro-track');
    if (!track) return;

    if (track.querySelector('.clone')) return;

    const prevBtn = carousel.querySelector('.prev');
    const nextBtn = carousel.querySelector('.next');
    const slides = [...track.querySelectorAll('.slide')];
    if (slides.length === 0) return;

    const numVisible = 3;
    const clonesBefore = slides.slice(-numVisible).map(s => s.cloneNode(true));
    const clonesAfter = slides.slice(0, numVisible).map(s => s.cloneNode(true));

    clonesBefore.forEach(clone => {
      clone.classList.add('clone');
      track.insertBefore(clone, track.firstChild);
    });

    clonesAfter.forEach(clone => {
      clone.classList.add('clone');
      track.appendChild(clone);
    });

    let currentIndex = numVisible;

    function getStepSize() {
      const slide = track.querySelector('.slide');
      const style = window.getComputedStyle(track);
      const gap = parseFloat(style.gap) || 16;
      return slide ? slide.offsetWidth + gap : 0;
    }

    function scrollToSlide(index, smooth = true) {
      currentIndex = index;
      const stepSize = getStepSize();
      track.scrollTo({
        left: stepSize * currentIndex,
        behavior: smooth ? 'smooth' : 'auto'
      });
    }

    setTimeout(() => {
      scrollToSlide(numVisible, false);
    }, 100);

    let isAdjusting = false;
    track.addEventListener('scroll', () => {
      if (isAdjusting) return;
      const stepSize = getStepSize();
      if (!stepSize) return;

      const totalSlidesCount = track.querySelectorAll('.slide').length;
      const currentScrollIndex = Math.round(track.scrollLeft / stepSize);

      if (currentScrollIndex >= totalSlidesCount - numVisible) {
        isAdjusting = true;
        currentIndex = numVisible;
        track.scrollTo({ left: stepSize * currentIndex, behavior: 'auto' });
        setTimeout(() => { isAdjusting = false; }, 60);
      } else if (currentScrollIndex <= 0) {
        isAdjusting = true;
        currentIndex = totalSlidesCount - numVisible * 2;
        track.scrollTo({ left: stepSize * currentIndex, behavior: 'auto' });
        setTimeout(() => { isAdjusting = false; }, 60);
      }
    });

    function advanceNext() {
      const stepSize = getStepSize();
      if (!stepSize) return;
      const currentScrollIndex = Math.round(track.scrollLeft / stepSize);
      scrollToSlide(currentScrollIndex + 1, true);
    }

    function advancePrev() {
      const stepSize = getStepSize();
      if (!stepSize) return;
      const currentScrollIndex = Math.round(track.scrollLeft / stepSize);
      scrollToSlide(currentScrollIndex - 1, true);
    }

    let autoPlayTimer = null;
    function startAutoplay() {
      stopAutoplay();
      autoPlayTimer = setInterval(advanceNext, 3500);
    }
    function stopAutoplay() {
      if (autoPlayTimer) clearInterval(autoPlayTimer);
    }

    startAutoplay();

    carousel.addEventListener('mouseenter', stopAutoplay);
    carousel.addEventListener('mouseleave', startAutoplay);
    carousel.addEventListener('touchstart', stopAutoplay, { passive: true });

    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      advanceNext();
      startAutoplay();
    });

    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      advancePrev();
      startAutoplay();
    });
  }

  function initGalleryCarousel() {
    const wrapper = document.querySelector('.gal-carousel-wrapper');
    if (!wrapper) return;
    const track = wrapper.querySelector('#gal');
    const prevBtn = wrapper.querySelector('.gal-car-btn.prev');
    const nextBtn = wrapper.querySelector('.gal-car-btn.next');
    if (!track || !prevBtn || !nextBtn) return;

    const getStepSize = () => {
      const slide = track.querySelector('.figure');
      return slide ? slide.offsetWidth + 16 : track.clientWidth * 0.8;
    };

    prevBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      track.scrollBy({ left: -getStepSize(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      track.scrollBy({ left: getStepSize(), behavior: 'smooth' });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initInfiniteGastroCarousel();
    initGalleryCarousel();
  });
  initInfiniteGastroCarousel();
  initGalleryCarousel();
</script>

