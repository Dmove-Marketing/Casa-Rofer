const galleryImages = [
  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria-atualizada_corporativos15.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria-atualizada_corporativos14.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria-atualizada_corporativos13.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria-atualizada_corporativos12.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria-atualizada_corporativos11.webp',
