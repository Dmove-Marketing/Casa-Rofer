  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria_nova_corporativos01_resultado.webp',
  'https://media.dmove.com.br/clients/casa-rofer/photos/galeria_nova_corporativos03_resultado.webp'
];

const eventTypes = [
  { name: 'Convenções e plenárias', desc: 'Estrutura completa de áudio, vídeo e projeção para palestras e alinhamentos estratégicos da sua equipe.' },
  { name: 'Coquetéis e networking', desc: 'Cenários ideais para um coquetel corporativo e networking de alto valor com clientes e parceiros de negócios.' },
  { name: 'Palestras e workshops', desc: 'Formato auditório, workshop ou sala de aula em espaços integrados que estimulam a troca de conhecimento.' },
  { name: 'Treinamentos', desc: 'Salões modulares que se adaptam a diferentes formatos de sala de aula e dinâmicas de aprendizado.' },
  { name: 'Lançamentos de produtos', desc: 'Cenografia marcante e impacto visual para apresentar suas novidades ao mercado com estilo.' },
  { name: 'Premiações', desc: 'Atmosfera sofisticada com gastronomia premium para celebrar as conquistas e metas alcançadas.' },
  { name: 'Confraternizações', desc: 'Celebrações corporativas sob medida, integrando gastronomia exclusiva e entretenimento de alto nível.' },
  { name: 'Eventos institucionais', desc: 'Encontros formais e celebrações de marcos históricos da marca conduzidos com total excelência.' }
];

const testimonials = [
  {
    stars: '★★★★★',
    quote: '"Realizamos a convenção anual da nossa empresa na Casa Rofer e a experiência foi extraordinária. A infraestrutura tecnológica atendeu perfeitamente às nossas necessidades de projeção e sonorização, e o serviço de buffet foi impecável. Recebemos muitos elogios dos nossos parceiros e diretores."',
    author: 'Mariana S.',
    role: 'Diretora de Eventos'
  },
  {
    stars: '★★★★★',
    quote: '"O espaço é moderno, elegante e de fácil localização no Brooklin. A integração entre o salão principal e a área externa foi perfeita para o nosso coquetel de lançamento de produto. O atendimento consultivo da equipe fez toda a diferença na nossa organização."',
    author: 'Rodrigo M.',
    role: 'Gerente de Marketing'
  },
  {
    stars: '★★★★★',
    quote: '"Excelente infraestrutura para treinamentos e workshops corporativos. A flexibilidade na montagem do layout e a atenção aos mínimos detalhes pela equipe da Casa Rofer garantiram a previsibilidade e o sucesso do nosso evento institucional."',
    author: 'Camila T.',
    role: 'Coordenadora de DHO'
  }
];
---

<Base
  title="Espaço para Eventos Corporativos em São Paulo | Casa Rofer"
  description="Espaço para eventos corporativos em São Paulo: dois ambientes para até 250 convidados no Brooklin. Convenções, coquetéis, palestras e treinamentos."
  ogImage="/images/og-index.jpg"
  canonical="https://eventos.casarofer.com.br/eventos-corporativos/"
  whatsAppShowEmpresaField
>
<!-- ===== HERO ===== -->
<header class="hero" id="top">
  <div class="hero-bg">
    <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/hero_corporativo_resultado.webp" alt="Espaço para eventos corporativos na Casa Rofer, Brooklin, São Paulo" priority />
  </div>
  <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/logo-white.webp" alt="Casa Rofer" class="hero-logo" width={190} sizes="190px" />
  <div class="hero-inner">
    <p class="hero-sub reveal in">Brooklin&nbsp; · &nbsp;São Paulo</p>
    <div class="hero-divider reveal in d1"></div>
    <h1 class="reveal in d2">O espaço para <br class="br-mobile"><span class="accent">eventos corporativos</span><br>de empresas que valorizam excelência</h1>
    <div class="hero-cta reveal in d3">
      <a href="#contato" class="btn white">Solicite orçamento</a>
    </div>
  </div>
</header>

<!-- ===== AUTORIDADE ===== -->
<section class="authority">
  <div class="wrap">
    <div class="stat reveal"><b>2 ambientes integrados</b></div>
    <div class="sep"></div>
    <div class="stat reveal d1"><b>Até 250 convidados</b></div>
    <div class="sep"></div>
    <div class="stat reveal d2"><b>1.300m² de área útil</b></div>
  </div>
</section>

<!-- ===== SOLUÇÃO 360° ===== -->
<section id="solucao-360" class="pad" style="background:#FFFFFF">
  <div class="wrap">
    <div class="center" style="max-width:820px;margin-inline:auto">
      <p class="eyebrow reveal">Solução 360°</p>
      <h2 class="section-title center reveal d1">Soluções <span class="accent">360º</span></h2>
    </div>
  </div>

  <div class="solucao-wrap" style="margin-top:70px">
    <div class="solucao-split">
      <div class="solucao-text reveal">
        <p>A Casa Rofer é um espaço para eventos corporativos em São Paulo, no coração do Brooklin. Cada evento é construído de forma integrada, reunindo estrutura, gastronomia, ambientação e operação em uma única solução.</p>
        <p>Mais do que oferecer diferentes serviços, atuamos em cocriação com nossos clientes, alinhando estética, funcionalidade e identidade em cada projeto. Uma equipe especializada acompanha todas as etapas, do planejamento à execução, garantindo que cada detalhe esteja conectado ao propósito do evento.</p>
        <p>Uma estrutura completa para transformar ideias em eventos únicos, com excelência em cada etapa.</p>
      </div>

      <div class="video-frame solucao-video reveal d1">
        <Video
          src="https://media.dmove.com.br/clients/casa-rofer/videos/video-solucao_corporativo_(1).webm"
          poster="https://media.dmove.com.br/clients/casa-rofer/photos/capa-video_corporativos_resultado.webp"
          title="Casa Rofer | Solução 360° para Eventos Corporativos"
          description="Conheça a solução 360° da Casa Rofer para eventos corporativos no Brooklin, São Paulo."
          uploadDate="2026-08-06"
        />
      </div>
    </div>
  </div>
</section>

<!-- ===== DIFERENCIAIS ===== -->
<section id="diferenciais" class="pad" style="background:#F3F0EA">
  <div class="wrap center">
    <p class="eyebrow reveal">Diferenciais</p>
    <h2 class="section-title center reveal d1" style="max-width:35ch">Tudo o que seu <br class="br-mobile">evento precisa.<br><span class="accent">Em um só lugar.</span></h2>
  </div>
  <div class="wrap" style="max-width:1600px">
    <div class="dif-grid dif-grid-corp reveal">
      <div class="dif-card">
        <div class="dif-card-img-wrap">
          <Img 
            src="https://media.dmove.com.br/clients/casa-rofer/photos/soluca-360_corporativo_resultado.webp"
            alt="Solução 360º"
            class="dc-solucao360"
            sizes="(max-width:760px) calc(100vw - 48px), (max-width:1024px) calc(33vw - 20px), 390px"
          />
        </div>
        <span>Solução 360º</span>
      </div>
      <div class="dif-card">
        <div class="dif-card-img-wrap">
          <Img 
            src="https://media.dmove.com.br/clients/casa-rofer/photos/gastronomia_corporativo_resultado.webp"
            alt="Gastronomia"
            class="dc-gastronomia"
            sizes="(max-width:760px) calc(100vw - 48px), (max-width:1024px) calc(33vw - 20px), 390px"
          />
        </div>
        <span>Gastronomia</span>
      </div>
      <div class="dif-card">
        <div class="dif-card-img-wrap">
          <Img 
            src="https://media.dmove.com.br/clients/casa-rofer/photos/coquetelaria_corporativo_resultado.webp"
            alt="Coquetelaria"
            class="dc-coquetelaria"
            sizes="(max-width:760px) calc(100vw - 48px), (max-width:1024px) calc(33vw - 20px), 390px"
          />
        </div>
        <span>Coquetelaria</span>
      </div>
      <div class="dif-card">
        <div class="dif-card-img-wrap">
          <Img 
            src="https://media.dmove.com.br/clients/casa-rofer/photos/ambientacao_corporativo_resultado.webp"
            alt="Ambientação"
            class="dc-ambientacao"
            sizes="(max-width:760px) calc(100vw - 48px), (max-width:1024px) calc(33vw - 20px), 390px"
          />
        </div>
        <span>Ambientação</span>
      </div>
      <div class="dif-card">
        <div class="dif-card-img-wrap">
          <Img 
            src="https://media.dmove.com.br/clients/casa-rofer/photos/tecnologia_corporativo_resultado.webp"
            alt="Tecnologia"
            class="dc-tecnologia"
            sizes="(max-width:760px) calc(100vw - 48px), (max-width:1024px) calc(33vw - 20px), 390px"
          />
        </div>
        <span>Tecnologia</span>
      </div>
      <div class="dif-card">
        <div class="dif-card-img-wrap">
          <Img 
            src="https://media.dmove.com.br/clients/casa-rofer/photos/mobiliario_corporativo_resultado.webp"
            alt="Mobiliário"
            class="dc-mobiliario"
            sizes="(max-width:760px) calc(100vw - 48px), (max-width:1024px) calc(33vw - 20px), 390px"
          />
        </div>
        <span>Mobiliário</span>
      </div>
      <div class="dif-card">
        <div class="dif-card-img-wrap">
          <Img 
            src="https://media.dmove.com.br/clients/casa-rofer/photos/decoracao_corporativo_resultado.webp"
            alt="Decoração"
            class="dc-decoracao"
            sizes="(max-width:760px) calc(100vw - 48px), (max-width:1024px) calc(33vw - 20px), 390px"
          />
        </div>
        <span>Decoração</span>
      </div>
      <div class="dif-card">
        <div class="dif-card-img-wrap">
          <Img 
            src="https://media.dmove.com.br/clients/casa-rofer/photos/sonorizacao_corporativo_resultado.webp"
            alt="Sonorização/DJ"
            class="dc-sonorizacao"
            sizes="(max-width:760px) calc(100vw - 48px), (max-width:1024px) calc(33vw - 20px), 390px"
          />
        </div>
        <span>Sonorização/DJ</span>
      </div>
    </div>
  </div>
</section>

<!-- ===== ATENDIMENTO CONSULTIVO / OPERAÇÃO INTEGRADA ===== -->
<section id="processo" class="pad" style="background:#FFFFFF">
  <div class="wrap">
    <div class="band">
      <div class="band-media reveal">
        <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/atendimento-consultivo__corporativo-v2.webp" alt="Atendimento consultivo na Casa Rofer" sizes="(max-width:900px) calc(100vw - 48px), 600px" />
      </div>
      <div class="band-text">
        <p class="space-tag reveal">Atendimento consultivo</p>
        <h3 class="reveal d1" style="font-size:clamp(1.4rem,2.6vw,2rem);color:var(--title);margin-bottom:16px">Um planejamento alinhado aos <br><span class="accent">seus objetivos</span></h3>
        <p class="lead reveal d2">Cada projeto é desenvolvido de acordo com os objetivos da empresa. Nossa equipe acompanha todas as etapas para garantir organização, previsibilidade e tranquilidade durante toda a jornada.</p>
      </div>
    </div>

    <div class="band rev" style="margin-top:clamp(48px,7vw,90px)">
      <div class="band-media reveal">
        <Img
          src="https://media.dmove.com.br/clients/casa-rofer/photos/operacao-integrada_corporativo-v2_resultado.webp"
          alt="Operação integrada corporativa na Casa Rofer"
          style="object-position: right center;"
          sizes="(max-width:900px) calc(100vw - 48px), 600px"
        />
      </div>
      <div class="band-text">
        <p class="space-tag reveal">Operação integrada</p>
        <h3 class="reveal d1" style="font-size:clamp(1.4rem,2.6vw,2rem);color:var(--title);margin-bottom:16px">Execução impecável em <br><span class="accent">cada detalhe</span></h3>
        <p class="lead reveal d2">Com um único parceiro coordenando todos os serviços, eliminamos retrabalhos, facilitamos a comunicação entre fornecedores e garantimos uma execução muito mais eficiente.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== ESPAÇOS ===== -->
<section id="espacos" class="pad" style="background:#F3F0EA">
  <div class="wrap">
    <div class="center" style="max-width:1100px;margin-inline:auto">
      <p class="eyebrow reveal">Os Espaços</p>
      <h2 class="section-title center reveal d1" style="max-width:40ch"><span class="accent">Dois ambientes versáteis</span><br>para eventos corporativos<br>de alto padrão</h2>
    </div>

    <div class="spaces-stack" style="margin-top:70px">
      <!-- Michelangelo -->
      <div class="space-card reveal">
        <div class="space-figure">
          <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao_michelangelo.webp" alt="Salão Michelângelo, espaço para eventos corporativos" sizes="(max-width:760px) calc(100vw - 48px), 600px" />
        </div>
        <div class="space-body">
          <p class="space-tag">Salão 01</p>
          <h3>Salão <span class="accent">Michelângelo</span></h3>
          <p class="lead">Digno da imponência de grandes eventos, surpreende com toda a flexibilidade, estrutura, conforto, elegância e inovação.</p>
          <a class="btn ghost" href="#contato">Agende uma visita</a>
        </div>
      </div>

      <!-- Da Vinci -->
      <div class="space-card rev reveal d1">
        <div class="space-figure">
          <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/salao-da-vinci_corporativo03_resultado.webp" alt="Salão Leonardo da Vinci, espaço para eventos corporativos" sizes="(max-width:760px) calc(100vw - 48px), 600px" />
        </div>
        <div class="space-body">
          <p class="space-tag">Salão 02</p>
          <h3>Salão <span class="accent">Leonardo da Vinci</span></h3>
          <p class="lead">Completamente banhado em luz natural, se destaca pela capacidade de conexão com a natureza estando sempre à espera do raiar do sol ou do brilho das estrelas.</p>
          <a class="btn ghost" href="#contato">Agende uma visita</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== TIPOS DE EVENTOS ===== -->
<section id="tipos-eventos" class="pad" style="background:#FFFFFF">
  <div class="wrap">
    <div class="center" style="max-width:820px;margin-inline:auto">
      <p class="eyebrow reveal">Eventos</p>
      <h2 class="section-title center reveal d1" style="max-width:35ch">Soluções para <br class="br-mobile">cada momento da <br><span class="accent">sua empresa</span></h2>
    </div>

    <div class="events-grid">
      {eventTypes.map((item, idx) => (
        <div class="event-card reveal" style={`transition-delay: ${idx * 0.05}s`}>
          <div class="event-icon-wrapper">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="event-icon">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
            </svg>
          </div>
          <h3>{item.name}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== GASTRONOMIA ===== -->
<section id="gastronomia" class="pad" style="background:#F3F0EA">
  <div class="wrap">
    <p class="eyebrow reveal center">Buffet Rofer</p>
  </div>
  <div class="gastro-wrap" style="margin-top:52px">
    <div class="carousel reveal gastro-carousel" id="gastronomy-carousel">
      <button class="car-btn prev" aria-label="Anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 18l-6-6 6-6"/></svg></button>
      <div class="car-track gastro-track">
        {gastronomiaImages.map((src) => (
          <div class="slide"><Img src={src} alt="Gastronomia Corporativa Rofer" sizes="(max-width:760px) calc(100vw - 48px), (max-width:1024px) 46vw, 370px" /></div>
        ))}
      </div>
      <button class="car-btn next" aria-label="Próximo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18l6-6-6-6"/></svg></button>
    </div>
  </div>
</section>

<!-- ===== PARCEIROS ===== -->
<section class="partners-section" style="background:#FFFFFF">
  <div class="wrap center">
    <p class="eyebrow reveal">Parceiros</p>
    <h2 class="section-title center reveal d1" style="margin-bottom:20px">Empresas que <br><span class="accent">confiam seus eventos</span><br>à Casa Rofer</h2>
  </div>
  
  <div class="wrap partners-carousel-wrap reveal d2" style="max-width: 960px;">
    <div class="partners-viewport">
      <div class="partners-track">
        {partnerLogos.map((src) => (
          <div class="partners-logo-item">
            <img src={src} alt="Logo de parceiro corporativo" loading="lazy" />
          </div>
        ))}
        {partnerLogos.map((src) => (
          <div class="partners-logo-item">
            <img src={src} alt="Logo de parceiro corporativo" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ===== DEPOIMENTOS ===== -->
<section class="feedbacks pad">
  <div class="fb-bg" data-parallax="0.18">
    <Img src="https://media.dmove.com.br/clients/casa-rofer/photos/galeria_corporativo03_resultado.webp" alt="Depoimentos corporativos na Casa Rofer" />
  </div>
  <div class="wrap fb-inner">
    <p class="eyebrow center reveal" style="color:var(--sand)">Depoimentos</p>
    <h2 class="section-title center reveal d1" style="color:#fff;margin-inline:auto;max-width:48ch;margin-bottom:24px">Quem realiza eventos <br class="br-mobile">na Casa Rofer<br><span class="accent">reconhece a diferença</span><br>nos mínimos detalhes</h2>
    <p class="fb-text center reveal d2">Histórias reais de quem viveu momentos corporativos de sucesso conosco.</p>
    
    <div class="fb-carousel-container reveal d2" style="margin-top:50px">
